#!/usr/bin/python3
"""Operator-only activation after native Forgejo setup, with explicit private TLS."""
import argparse, ipaddress, json, os, pwd, shutil, stat, subprocess
from pathlib import Path
from urllib.parse import urlsplit

parser = argparse.ArgumentParser()
parser.add_argument('--bind-ip', required=True, help='explicit private appliance address')
parser.add_argument('--certificate', help='PEM certificate covering the Forgejo/Sodaspaces browser origin')
parser.add_argument('--private-key', help='PEM private key; never committed')
parser.add_argument('--local-tls', action='store_true', help='use Caddy local certificates for the selected private IP; client trust is explicit')
args = parser.parse_args()
if os.geteuid() != 0:
    parser.error('native host operator/root required')
if args.local_tls:
    if args.certificate or args.private_key:
        parser.error('local TLS and supplied certificates are separate choices')
elif not args.certificate or not args.private_key:
    parser.error('select --local-tls or supply both --certificate and --private-key')
address = ipaddress.ip_address(args.bind_ip)
if address.is_unspecified or address.is_multicast or address.is_global or address.is_loopback:
    parser.error('select an explicit private address, not loopback or a public administration exposure')
root = Path('/etc/soda')
if (root / 'activated').exists():
    parser.error('already activated; use explicit native configuration maintenance instead of blind reactivation')
cfg = json.loads((root / 'dashboard.json').read_text())
if 'public_url' in cfg:
    parser.error('legacy separate-origin configuration; use rehearsed configuration maintenance')
operator_id = cfg.get('operator_id')
if type(operator_id) is not int or not 1 <= operator_id <= (1 << 63) - 1:
    parser.error('dashboard operator identity is invalid')
for key in ('forgejo_url',):
    u = urlsplit(cfg[key])
    if u.scheme != 'https' or not u.hostname or u.username or u.password or u.query or u.fragment or u.path not in ('', '/') or any(c in cfg[key] for c in '\r\n'):
        parser.error('invalid HTTPS browser origin')
if args.local_tls:
    origin = urlsplit(cfg['forgejo_url'])
    if origin.hostname != str(address) or origin.port not in (None, 443):
        parser.error('local TLS uses the exact selected private IP on HTTPS port 443')
if cfg['forgejo_internal_url'] != 'http://127.0.0.1:3000' or cfg['listen'] != '127.0.0.1:8080':
    parser.error('bundled service recipes require the documented internal listeners')
if cfg['grant_key_file'] != '/etc/soda/grant-key' or cfg['host_socket'] != '/run/soda/host.sock' or (cfg.get('identity_socket') or '/run/soda/identity/admin.sock') != '/run/soda/identity/admin.sock':
    parser.error('bundled isolated service mounts require the standard private file and socket paths')
account = pwd.getpwnam('soda')
if account.pw_uid != 2000 or account.pw_gid != 2000:
    parser.error('unexpected native soda service identity')
root.chmod(0o750)
os.chown(root, 0, account.pw_gid)
for p in [root / 'dashboard.json', Path(cfg['grant_key_file'])]:
    if p.parent != root or p.is_symlink():
        parser.error('credentials must be regular operator-created files under /etc/soda')
    os.chown(p, 0, account.pw_gid)
    p.chmod(0o640)
# The extension package needs only the stable operator ID for its navigation
# guard. Keep it in the package's private data directory, outside the image.
extension_root = Path('/var/lib/soda/forgejo/gitea/extensions')
for path in (Path('/var/lib/soda'), Path('/var/lib/soda/forgejo'), Path('/var/lib/soda/forgejo/gitea'), extension_root):
    if path.is_symlink():
        parser.error('Forgejo extension data path must not contain symlinks')
extension_data = extension_root / '.data'
extension_root.mkdir(mode=0o700, exist_ok=True)
os.chown(extension_root, 1000, 1000)
extension_root.chmod(0o700)
if extension_data.is_symlink():
    parser.error('Forgejo extension data path must not contain symlinks')
extension_data.mkdir(mode=0o700, exist_ok=True)
os.chown(extension_data, 1000, 1000)
operator_data = extension_data / 'soda'
if operator_data.is_symlink():
    parser.error('Soda extension data path must not contain symlinks')
operator_data.mkdir(mode=0o700, exist_ok=True)
os.chown(operator_data, 1000, 1000)
operator_file = operator_data / 'operator-id'
if operator_file.exists() or operator_file.is_symlink():
    info = operator_file.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        parser.error('Soda extension operator identity must be a private regular file')
operator_file.write_text(str(operator_id) + '\n')
os.chown(operator_file, 1000, 1000)
operator_file.chmod(0o600)
tls = root / 'tls'
tls.mkdir(mode=0o700, exist_ok=True)
if not args.local_tls:
    for source, dest in [(args.certificate, 'cert.pem'), (args.private_key, 'key.pem')]:
        shutil.copyfile(source, tls / dest)
        (tls / dest).chmod(0o600)
tls_input = 'internal' if args.local_tls else '/etc/soda/tls/cert.pem /etc/soda/tls/key.pem'
(root / 'proxy.env').write_text(f'FORGEJO_ORIGIN={cfg["forgejo_url"]}\nSODA_BIND={address}\nSODA_TLS={tls_input}\n')
(root / 'proxy.env').chmod(0o600)
envpath = root / 'forgejo.env'
values = dict(line.split('=', 1) for line in envpath.read_text().splitlines() if line and not line.startswith('#') and '=' in line)
values.update({'FORGEJO__server__ROOT_URL': cfg['forgejo_url'].rstrip('/') + '/', 'FORGEJO__server__DOMAIN': urlsplit(cfg['forgejo_url']).hostname, 'FORGEJO__server__SSH_PORT': '2222', 'FORGEJO__security__INSTALL_LOCK': 'true'})
# Forgejo appends its email hash and size query to this supported provider URL.
# Dynamic provider/federation settings remain native Forgejo administrator state.
values['FORGEJO__picture__GRAVATAR_SOURCE'] = cfg['forgejo_url'].rstrip('/') + '/-/soda/avatars/v1/'
values.update({
    'FORGEJO__extensions__ENABLED': 'true',
    'FORGEJO__extensions__PATH': '/data/gitea/extensions',
    'FORGEJO__extensions__REQUIRED_IDS': 'soda',
    'FORGEJO__extensions__SERVICE_CALLBACK_PATH': '/ipc/host.sock',
})
values.setdefault('FORGEJO__server__SSH_DOMAIN', str(address))
envpath.write_text(''.join(f'{k}={v}\n' for k, v in values.items()))
envpath.chmod(0o600)
network = Path('/etc/containers/systemd/forgejo.container.d')
network.mkdir(parents=True, exist_ok=True)
bind = f'[{address}]' if address.version == 6 else str(address)
(network / '10-private-network.conf').write_text(f'[Container]\nPublishPort=\nPublishPort=127.0.0.1:3000:3000\nPublishPort={bind}:2222:22\n')
(root / 'activated').touch(mode=0o600)
subprocess.run(['systemctl', 'daemon-reload'], check=True)
# No enable: Quadlet-generated units refuse it. Boot-time binding lives in
# soda-console.service; activation only (re)starts the configured listeners.
subprocess.run(['systemctl', 'restart', 'forgejo.service'], check=True)
subprocess.run(['systemctl', 'start', 'soda-dashboard.service', 'soda-proxy.service'], check=True)
print('Activation requested. Inspect native service state and perform the later login/SSH validation; this is not a validation result.')
if args.local_tls:
    print('Caddy manages local HTTPS certificates. Trust its public root certificate on each intended client before opening Soda; no domain or public certificate service is required.')
