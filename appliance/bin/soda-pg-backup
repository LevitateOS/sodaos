#!/bin/bash
# Consistent backup of the appliance PostgreSQL databases.
# Dumps globals plus each listed database (default: forgejo soda) into a new
# timestamped directory, verifies the archives, then rotates old runs.
# Authentication is container-local peer auth via podman exec; no password
# appears in argv, env, logs or the backup itself.
#
# Environment overrides (used by tests; production uses the defaults):
#   SODA_PG_CONTAINER  container name (default soda-postgres)
#   SODA_PG_BACKUP_DIR backup root (default /var/lib/soda/backups/postgres)
#   SODA_PG_DATABASES  space-separated databases (default "forgejo soda")
#   SODA_PG_KEEP       runs to retain (default 7)
set -euo pipefail

container="${SODA_PG_CONTAINER:-soda-postgres}"
backup_root="${SODA_PG_BACKUP_DIR:-/var/lib/soda/backups/postgres}"
databases="${SODA_PG_DATABASES:-forgejo soda}"
keep="${SODA_PG_KEEP:-7}"

case "$keep" in (*[!0-9]*|'') echo "SODA_PG_KEEP must be a positive integer" >&2; exit 2;; esac
[ "$keep" -ge 1 ] || { echo "SODA_PG_KEEP must be a positive integer" >&2; exit 2; }

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
work="$backup_root/.in-progress-$stamp-$$"
final="$backup_root/$stamp"
mkdir -p "$work"
trap 'rm -rf "$work"' EXIT

# One pg_dump per database, each a single consistent snapshot; globals hold
# roles and permissions shared by both databases.
podman exec -u postgres "$container" pg_dumpall --globals-only >"$work/globals.sql"
for db in $databases; do
	podman exec -u postgres "$container" pg_dump --format=custom "$db" >"$work/$db.dump"
done

# Verify before publishing: every archive must be a non-empty custom-format
# dump (PGDMP magic) and globals must hold both roles.
for db in $databases; do
	[ -s "$work/$db.dump" ] || { echo "empty dump for $db" >&2; exit 1; }
	magic="$(head -c 5 "$work/$db.dump")"
	[ "$magic" = "PGDMP" ] || { echo "bad archive magic for $db" >&2; exit 1; }
done
grep -q 'CREATE ROLE forgejo' "$work/globals.sql" || { echo "globals lack forgejo role" >&2; exit 1; }
grep -q 'CREATE ROLE soda' "$work/globals.sql" || { echo "globals lack soda role" >&2; exit 1; }

mv "$work" "$final"
trap - EXIT

# Rotate only after the new run is published; never delete the run just made.
mapfile -t runs < <(ls -1 "$backup_root" | grep -E '^[0-9]{8}T[0-9]{6}Z$' | sort)
while [ "${#runs[@]}" -gt "$keep" ]; do
	rm -rf "$backup_root/${runs[0]}"
	runs=("${runs[@]:1}")
done

echo "backup complete: $final"
