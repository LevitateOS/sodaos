{{/* Forgejo 15.0.7 uses this template for both people and organizations. */}}
{{template "base/head" .}}
<main aria-label="{{.Title}}" class="page-content explore users soda-page soda-explore soda-explore-people" data-signed="{{.IsSigned}}">
  <div class="ui container soda-page-container">
    {{$introTitle := "Meet the people behind the code."}}
    {{$introDescription := "Find collaborators and discover what they’re building."}}
    {{$introArtwork := "users-papercraft.png?v=2"}}
    {{if .PageIsExploreOrganizations}}
      {{$introTitle = "Good work happens together."}}
      {{$introDescription = "Find the teams bringing projects to life."}}
      {{$introArtwork = "orgs-papercraft.png"}}
    {{end}}
    {{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" "Discover & collaborate" "Title" $introTitle "Description" $introDescription "Artwork" $introArtwork}}
    <div class="soda-toolbar soda-p-toolbar">
    {{template "custom/explore_navbar" .}}
    {{template "explore/search" .}}
    </div>
    <div class="soda-list">
    {{if .Users}}
      {{template "explore/user_list" .}}
    {{else}}
      {{template "custom/explore_empty" .}}
    {{end}}
    </div>
    {{template "base/paginate" .}}
  </div>
</main>
{{template "base/footer" .}}
