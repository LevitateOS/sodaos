{{/* Stock Forgejo 15.0.7 owns code search, result rendering and authorization. */}}
{{template "base/head" .}}
<main aria-label="{{.Title}}" class="page-content explore users soda-page soda-explore soda-explore-code" data-signed="{{.IsSigned}}">
	<div class="ui container soda-page-container">
		{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" "Discover & collaborate" "Title" "Find code across repositories." "Description" "Search the code and symbols you already have access to." "Artwork" "explore-papercraft.png?v=2"}}
		<div class="soda-toolbar soda-toolbar--plain soda-p-toolbar">
			{{template "custom/explore_navbar" .}}
		</div>
		<div class="soda-code-search">
			{{template "shared/search/code/search" .}}
		</div>
	</div>
</main>
{{template "base/footer" .}}
