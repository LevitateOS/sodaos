{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new issue soda-repo-issue-editor">
	{{template "repo/header" .}}
	<div class="ui container soda-repo-issue-editor-container soda-p-editor-container soda-form-editor">
{{template "custom/soda/page_intro" dict "TitleID" "soda-form-title" "Title" (ctx.Locale.Tr "repo.issues.new") "Description" "Describe the problem, idea, or task." "Eyebrow" "" "Artwork" "issues-papercraft.png" "Class" "soda-form-editor-intro"}}
		<div class="soda-repo-editor-card soda-p-form-host">{{template "repo/issue/new_form" .}}</div>
	</div>
</div>
{{template "base/footer" .}}
