{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings options" "title" (ctx.Locale.Tr "repo.settings.units.units"))}}
<div class="user-main-content twelve wide column repo-setting-content soda-repo-settings-detail soda-repo-settings-units">
	<form class="ui form" method="post" action="{{.RepoLink}}/settings/units">
		{{template "repo/settings/units/overview" .}}
		{{template "repo/settings/units/issues" .}}
		{{if not .IsMirror}}
			{{template "repo/settings/units/pulls" .}}
		{{end}}
		{{template "repo/settings/units/wiki" .}}
	</form>
</div>
{{template "repo/settings/layout_footer" .}}
