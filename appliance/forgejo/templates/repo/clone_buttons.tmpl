{{/* Adapted from Forgejo 15.0.7 templates/repo/clone_buttons.tmpl (GPL-3.0-or-later); upstream SHA-256 909f391790b470a2156f0747dd3cb77da5a6702d41f675a3bc4394ea6e30f0bf. Presentation changes only. */}}
<!-- there is always at least one button (by context/repo.go) -->
{{if $.CloneButtonShowHTTPS}}
	<button class="ui small button" id="repo-clone-https" data-link="{{$.CloneButtonOriginLink.HTTPS}}">
		HTTPS
	</button>
{{end}}
{{if $.CloneButtonShowSSH}}
	<button class="ui small button" id="repo-clone-ssh" data-link="{{$.CloneButtonOriginLink.SSH}}">
		SSH
	</button>
{{end}}
<input id="repo-clone-url" size="20" class="js-clone-url soda-code-clone-url" value="{{$.CloneButtonOriginLink.HTTPS}}" readonly>
<button class="ui small icon button" id="clipboard-btn" data-tooltip-content="{{ctx.Locale.Tr "copy_url"}}" data-clipboard-target="#repo-clone-url" aria-label="{{ctx.Locale.Tr "copy_url"}}">
	{{svg "octicon-copy" 14}}
</button>
