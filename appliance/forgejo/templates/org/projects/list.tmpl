{{template "base/head" .}}
{{if .ContextUser.IsOrganization}}
	<div role="main" aria-label="{{.Title}}" class="page-content organization projects soda-page soda-org-projects soda-org-projects-list" data-signed="{{.IsSigned}}">
		{{template "org/header" .}}
		<div class="ui container soda-page-container">
			{{template "custom/soda/page_intro" dict "TitleID" "soda-org-projects-title" "Eyebrow" "Plan together" "Title" .Title "Description" "Organize work across repositories in one shared view." "Class" "soda-page-intro--compact"}}
			{{template "projects/list" .}}
		</div>
	</div>
{{else}}
	<div role="main" aria-label="{{.Title}}" class="page-content user profile soda-page soda-profile soda-org-projects soda-org-projects-list" data-signed="{{.IsSigned}}">
		<div class="ui container soda-page-container">
			<div class="soda-profile-layout">
				<div class="soda-profile-identity soda-profile-card-context">
					{{template "shared/user/profile_big_avatar" .}}
				</div>
				<div class="soda-profile-content">
					{{template "user/overview/header" .}}
					<h2 class="soda-profile-task-title">{{.Title}}</h2>
					{{template "projects/list" .}}
				</div>
			</div>
		</div>
	</div>
{{end}}
{{if not .ContextUser.IsOrganization}}{{template "custom/soda/profile_block_dialog" .}}{{end}}
{{template "base/footer" .}}
