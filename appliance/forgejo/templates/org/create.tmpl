{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content organization new org soda-page soda-org-create" data-signed="true">
	<div class="ui container soda-page-container">
		{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" "Build something together" "Title" (ctx.Locale.Tr "new_org.title") "Description" "A shared home for your team and its projects." "Artwork" "new-org-papercraft.png"}}
		<form class="ui form soda-form soda-p-form" action="{{.Link}}" method="post">
			<div class="soda-form-body">
				{{template "base/alert" .}}
				<fieldset class="soda-form-section soda-org-name {{if .Err_OrgName}}field error{{end}} soda-p-section">
					<label for="org_name">{{ctx.Locale.Tr "org.org_name_holder"}}</label>
					<input id="org_name" name="org_name" value="{{.org_name}}" autofocus required maxlength="40">
					<span class="help">{{ctx.Locale.Tr "org.org_name_helper"}}</span>
				</fieldset>

				<fieldset class="soda-form-section {{if .Err_OrgVisibility}}field error{{end}} soda-p-section">
					<legend>{{ctx.Locale.Tr "org.settings.visibility"}}</legend>
					<div class="inline-grouped-list">
						<div class="ui radio checkbox">
							<input class="enable-system-radio" name="visibility" type="radio" value="0" {{if .visibility.IsPublic}}checked{{end}}>
							<label>{{ctx.Locale.Tr "org.settings.visibility.public"}}</label>
						</div>
						<div class="ui radio checkbox">
							<input class="enable-system-radio" name="visibility" type="radio" value="1" {{if .visibility.IsLimited}}checked{{end}}>
							<label>{{ctx.Locale.Tr "org.settings.visibility.limited"}}</label>
						</div>
						<div class="ui radio checkbox">
							<input class="enable-system-radio" name="visibility" type="radio" value="2" {{if .visibility.IsPrivate}}checked{{end}}>
							<label>{{ctx.Locale.Tr "org.settings.visibility.private"}}</label>
						</div>
					</div>
				</fieldset>

				<fieldset id="permission_box" class="soda-form-section soda-p-section">
					<legend>{{ctx.Locale.Tr "org.settings.permission"}}</legend>
					<div class="inline-grouped-list">
						<div class="ui checkbox">
							<input type="checkbox" name="repo_admin_change_team_access" {{if .repo_admin_change_team_access}}checked{{end}}>
							<label>{{ctx.Locale.Tr "org.settings.repoadminchangeteam"}}</label>
						</div>
					</div>
				</fieldset>

				<div class="inline field">
					<button class="ui primary button">
						{{ctx.Locale.Tr "org.create_org"}}
					</button>
				</div>
			</div>
		</form>
	</div>
</div>
{{template "base/footer" .}}
