{{/* Soda public welcome page for stock Forgejo 15.0.9; native routes and authentication remain upstream-owned. */}}
{{template "base/head" .}}
<main class="page-content home soda-home" aria-label="{{ctx.Locale.Tr "home"}}">
	<header class="soda-home-nav">
		<a class="soda-home-brand" href="{{AppSubUrl}}/" aria-label="Soda OS home">
			<img class="soda-home-logo-light" src="{{AssetUrlPrefix}}/soda/source/soda-symbol-brutalist.svg" width="40" height="40" alt="Soda OS">
			<img class="soda-home-logo-dark" src="{{AssetUrlPrefix}}/soda/source/soda-symbol-brutalist-dark.svg" width="40" height="40" alt="Soda OS">
		</a>
		<nav aria-label="Main navigation" class="soda-home-links">
			<a href="{{AppSubUrl}}/explore/repos">Explore repositories</a>
			{{template "custom/soda/theme_toggle" dict}}
			<a class="soda-home-nav-signin" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}} <span aria-hidden="true">→</span></a>
		</nav>
	</header>
	<section class="soda-home-hero" aria-labelledby="soda-home-title">
		<div class="soda-home-copy">
			<p class="soda-home-eyebrow">Soda OS</p>
			<h1 id="soda-home-title">The operating system for software factories.</h1>
		</div>
		<div class="soda-home-entry">
			<p class="soda-home-lede">Run your coding agents on your infrastructure, with controlled access and reviewable results.</p>
			<div class="soda-home-actions">
				<a class="soda-home-primary" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}} <span aria-hidden="true">→</span></a>
				<a class="soda-home-secondary" href="{{AppSubUrl}}/explore/repos">Explore repositories <span aria-hidden="true">↗</span></a>
			</div>
			{{if .ShowRegistrationButton}}
			<p class="soda-home-account">New here? <a href="{{AppSubUrl}}/user/sign_up">Create an account</a></p>
			{{else}}
			<p class="soda-home-account">Joining the team? Ask your administrator for an account.</p>
			{{end}}
		</div>

	</section>
	<section class="soda-home-features" aria-label="Software factory workflow">
		<article><span class="soda-home-feature-number" aria-hidden="true">01</span><div><h2>Authorize work.</h2><p>Define a clear issue in Forgejo. An authorized operator admits it with permitted operations and time and resource limits.</p></div></article>
		<article><span class="soda-home-feature-number" aria-hidden="true">02</span><div><h2>Run and verify.</h2><p>Soda runs the agent as a supervised execution inside the persistent project, with time and resource limits, and records the outcome with separately tracked cleanup. Review checks the exact candidate commit before a person merges.</p></div></article>
		<article><span class="soda-home-feature-number" aria-hidden="true">03</span><div><h2>Review and merge.</h2><p>Inspect the pull request and merge the verified commit yourself. Work that cannot finish returns to a person. Persistent human projects support development and intervention.</p></div></article>
	</section>
</main>
{{template "base/footer" .}}
