{{/* The caller owns the empty-state decision and any permitted actions. */}}
{{with .Icon}}<div class="soda-empty-symbol" aria-hidden="true">{{svg . 32}}</div>{{end}}
{{with .Eyebrow}}<p class="soda-empty-eyebrow">{{.}}</p>{{end}}
<h2 class="soda-empty-title"{{with .TitleID}} id="{{.}}"{{end}}>{{.Title}}</h2>
{{with .Description}}<p class="soda-empty-description">{{.}}</p>{{end}}
