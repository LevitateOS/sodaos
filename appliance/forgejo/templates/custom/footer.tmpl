{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{if .Repository}}{{if not (or .Repository.IsBeingCreated .Repository.IsBroken)}}
<div id="sodaspaces-root" hidden data-sub-url="{{AppSubUrl}}" data-repository-id="{{.Repository.ID}}" data-signed="{{if .IsSigned}}true{{else}}false{{end}}" data-user-id="{{if .IsSigned}}{{.SignedUserID}}{{end}}">
	<button id="sodaspaces-button" type="button" class="ui primary button" aria-haspopup="dialog" aria-expanded="false" aria-controls="sodaspaces-drawer">{{svg "octicon-terminal" 16}} Sodaspaces</button>
	<dialog id="sodaspaces-drawer" aria-labelledby="sodaspaces-title">
		<div class="sodaspaces-panel">
			<header class="sodaspaces-heading"><div><p>Shared development</p><h2 id="sodaspaces-title">Sodaspaces</h2></div><button id="sodaspaces-close" type="button" class="ui basic button" autofocus>Close</button></header>
			<div id="sodaspaces-content" class="sodaspaces-content"></div>
		</div>
	</dialog>
</div>
<script type="module" src="{{AppSubUrl}}/assets/sodaspaces.js"></script>
{{end}}{{end}}
{{if .IsSigned}}
<div id="soda-notification-preview" class="soda-notification-preview" popover="auto" role="region" aria-labelledby="soda-notification-preview-title">
	<div class="soda-notification-preview-header">
		<strong id="soda-notification-preview-title">{{ctx.Locale.Tr "notifications"}}</strong>
		<button type="button" class="soda-notification-preview-close" aria-label="{{ctx.Locale.Tr "close"}}">{{svg "octicon-x" 16}}</button>
	</div>
	<p class="soda-notification-preview-status" role="status" aria-live="polite"></p>
	<div class="soda-notification-preview-content" hx-get="{{AppSubUrl}}/notifications?div-only=true&amp;soda-preview=true&amp;q=unread&amp;page=1&amp;perPage=5" hx-trigger="soda-notification-open" hx-target="this" hx-swap="innerHTML" hx-indicator="this" hx-sync="this:replace" hx-request='{"timeout":10000}'></div>
	<button type="button" class="soda-notification-preview-retry" hidden>Retry</button>
	<a class="soda-notification-preview-all" href="{{AppSubUrl}}/notifications">View all notifications</a>
</div>
<script src="{{AssetUrlPrefix}}/soda/forgejo/notification-preview.js?v=1"></script>
{{end}}
