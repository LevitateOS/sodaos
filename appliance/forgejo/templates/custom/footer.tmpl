{{/* SPDX-License-Identifier: Apache-2.0 */}}
{{/* The selected dashboard body owns its content mount, including invalid-ID feedback.
     Other routes and unknown/duplicate selectors keep their ordinary drawer. */}}
{{$sodaPage := false}}
{{if and .IsSigned .PageIsNews (eq .Link AppSubUrl)}}
  {{$view := ctx.Context.FormString "soda-view"}}
  {{$sodaPage = and (eq (len (ctx.Context.FormStrings "soda-view")) 1) (or (eq $view "spaces") (eq $view "runners") (eq $view "tailnet") (eq $view "repository-spaces"))}}
{{end}}
{{if and (not $sodaPage) (or .IsSigned .Repository)}}{{if not (and .Repository (or .Repository.IsBeingCreated .Repository.IsBroken))}}
<div id="sodaspaces-root" hidden data-sub-url="{{AppSubUrl}}" data-repository-id="{{if .Repository}}{{.Repository.ID}}{{end}}" data-signed="{{if .IsSigned}}true{{else}}false{{end}}" data-user-id="{{if .IsSigned}}{{.SignedUserID}}{{end}}">
	<button id="sodaspaces-button" type="button" aria-label="Sodaspaces" class="ui primary button" aria-expanded="false" aria-controls="sodaspaces-drawer">{{svg "octicon-terminal" 16}} <span>Sodaspaces</span></button>
	<aside id="sodaspaces-drawer" hidden aria-labelledby="sodaspaces-title">
		<div id="sodaspaces-divider" role="separator" tabindex="0" aria-label="Workspace width" aria-orientation="vertical" aria-controls="sodaspaces-drawer" aria-valuemin="35" aria-valuemax="65" aria-valuenow="50"></div>
		<div class="sodaspaces-panel">
			<header class="sodaspaces-heading"><h2 id="sodaspaces-title">Sodaspaces</h2><button id="sodaspaces-close" type="button" class="ui basic button" aria-label="Hide workspace">Hide</button></header>
			<div id="sodaspaces-content" class="sodaspaces-content"></div>
		</div>
	</aside>
</div>
<script type="module" src="{{AppSubUrl}}/assets/sodaspaces.js?v=2026-09-12.tailnet-2"></script>
{{if .Repository}}<script src="{{AssetUrlPrefix}}/soda/forgejo/repository-actions.js?v=4"></script>{{end}}
{{end}}{{end}}
{{if .IsSigned}}
<div id="soda-notification-preview" class="soda-notification-preview" popover="auto" role="region" aria-labelledby="soda-notification-preview-title">
	<div class="soda-notification-preview-header">
		<strong id="soda-notification-preview-title">{{ctx.Locale.Tr "notifications"}}</strong>
		<button type="button" class="soda-notification-preview-close" aria-label="{{ctx.Locale.Tr "close"}}">{{svg "octicon-x" 16}}</button>
	</div>
	<p class="soda-notification-preview-status" role="status" aria-live="polite"></p>
	<div class="soda-notification-preview-content" hx-get="{{AppSubUrl}}/notifications?div-only=true&amp;soda-preview=true&amp;q=unread&amp;page=1&amp;perPage=5" hx-trigger="soda-notification-open" hx-target="this" hx-swap="innerHTML" hx-indicator="this" hx-sync="this:replace" hx-request='{"timeout":10000}'></div>
	<button type="button" class="soda-notification-preview-retry" hidden>Retry</button>
	<a class="soda-notification-preview-all" href="{{AppSubUrl}}/notifications">View all notifications</a>
</div>
<script src="{{AssetUrlPrefix}}/soda/forgejo/notification-preview.js?v=1"></script>
<script type="module" src="{{AppSubUrl}}/assets/soda/forgejo/soda-settings-link.js?v=2026-09-12.tailnet-2"></script>
{{end}}
