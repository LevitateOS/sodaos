{{/* Presentation only: never infer the existence of records hidden by native visibility. */}}
<section class="soda-empty" aria-labelledby="soda-empty-title">
  <div class="soda-empty-symbol" aria-hidden="true">
    {{if .Keyword}}{{svg "octicon-search" 32}}{{else if .PageIsExploreRepositories}}{{svg "octicon-repo" 32}}{{else if .PageIsExploreOrganizations}}{{svg "octicon-organization" 32}}{{else}}{{svg "octicon-people" 32}}{{end}}
    <span class="soda-empty-spark"></span>
  </div>
  {{if .Keyword}}
    <p class="soda-empty-eyebrow">A little room to explore</p>
    <h2 id="soda-empty-title">No matches this time.</h2>
    <p>We couldn’t find {{if .PageIsExploreRepositories}}repositories{{else if .PageIsExploreOrganizations}}organizations{{else}}people{{end}} matching <strong>“{{.Keyword}}”</strong>. Try a different search, or start fresh.</p>
  {{else if .PageIsExploreRepositories}}
    <p class="soda-empty-eyebrow">Room for your next idea</p>
    <h2 id="soda-empty-title">No repositories to show.</h2>
    <p>Nothing is visible in this view right now. Reset the filters to see the repositories available to you.</p>
  {{else if .PageIsExploreOrganizations}}
    <p class="soda-empty-eyebrow">Good things start together</p>
    <h2 id="soda-empty-title">No organizations to show yet.</h2>
    <p>When organizations are available to you, you’ll find their shared home here.</p>
  {{else}}
    <p class="soda-empty-eyebrow">There’s room at the workbench</p>
    <h2 id="soda-empty-title">No people to show yet.</h2>
    <p>People with profiles visible to you will appear here. Check back as your community grows.</p>
  {{end}}
  <div class="soda-empty-actions">
    {{if .PageIsExploreRepositories}}
      <a class="soda-empty-primary" href="{{AppSubUrl}}/explore/repos?only_show_relevant=false">Reset search and filters {{svg "octicon-arrow-right" 16}}</a>
    {{else if .Keyword}}
      <a class="soda-empty-primary" href="{{AppSubUrl}}/explore/{{if .PageIsExploreOrganizations}}organizations{{else}}users{{end}}">Clear search {{svg "octicon-arrow-right" 16}}</a>
    {{else}}
      <a class="soda-empty-primary" href="{{AppSubUrl}}/explore/repos">Explore repositories {{svg "octicon-arrow-right" 16}}</a>
    {{end}}
    {{if and .IsSigned .PageIsExploreRepositories}}
      <a class="soda-empty-secondary" href="{{AppSubUrl}}/repo/create">{{ctx.Locale.Tr "new_repo.link"}}</a>
    {{else if and .IsSigned .PageIsExploreOrganizations}}
      {{if .SignedUser.CanCreateOrganization}}<a class="soda-empty-secondary" href="{{AppSubUrl}}/org/create">{{ctx.Locale.Tr "new_org.link"}}</a>{{end}}
    {{end}}
  </div>
</section>
