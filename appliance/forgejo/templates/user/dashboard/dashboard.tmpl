{{template "base/head" .}}
{{/* Presentation only: the native Home handler has already enforced account gates.
     FormString initializes Req.Form before FormStrings checks duplicate selectors. */}}
{{$sodaView := ""}}
{{if and .IsSigned .PageIsNews (eq .Link AppSubUrl)}}
  {{$requested := ctx.Context.FormString "soda-view"}}
  {{if and (eq (len (ctx.Context.FormStrings "soda-view")) 1) (or (eq $requested "spaces") (eq $requested "runners") (eq $requested "repository-spaces"))}}
    {{$sodaView = $requested}}
  {{end}}
{{end}}
{{if $sodaView}}
  {{$title := "Spaces"}}
  {{$repositoryID := ctx.Context.FormInt64 "repository_id"}}
  {{$valid := eq (len (ctx.Context.FormStrings "repository_id")) 0}}
  {{if eq $sodaView "runners"}}
    {{$title = "Runners"}}
  {{else if eq $sodaView "repository-spaces"}}
    {{$title = "Repository Spaces settings"}}
    {{$valid = and (eq (len (ctx.Context.FormStrings "repository_id")) 1) (gt $repositoryID 0) (eq (printf "%d" $repositoryID) (ctx.Context.FormString "repository_id"))}}
  {{end}}
  <main data-signed="true" class="page-content soda-page soda-native-page" aria-labelledby="soda-native-title">
    <div class="soda-page-container">
      {{template "custom/soda/page_intro" dict "TitleID" "soda-native-title" "Title" $title "Class" "soda-page-intro--compact"}}
      {{if $valid}}
        {{if ne $sodaView "spaces"}}<link rel="stylesheet" href="{{AppSubUrl}}/assets/soda-settings.css?v=2026-09-10.native-pages-6">{{end}}
        <div id="soda-native-content" data-view="{{$sodaView}}" data-actor="{{.SignedUserID}}" data-repository-id="{{if eq $sodaView "repository-spaces"}}{{$repositoryID}}{{end}}" data-document-title="{{$title}} - {{AppDisplayName}}">
          <noscript><p>JavaScript is required for Soda controls. <a href="{{AppSubUrl}}/">Return to your dashboard</a></p></noscript>
        </div>
        <script type="module" src="{{AssetUrlPrefix}}/soda/forgejo/soda-native-page.js?v=2026-09-10.native-pages-6"></script>
      {{else}}
        <p role="alert">Invalid Soda page destination.</p>
        <p><a href="{{AppSubUrl}}/">Return to your dashboard</a></p>
      {{end}}
    </div>
  </main>
{{else}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds soda-page soda-dashboard" data-signed="true">
  <div class="soda-page-container">
    <div class="soda-dashboard-grid">
      <section class="soda-dashboard-feed soda-list" aria-labelledby="soda-activity-title">
      {{$introTitle := printf "Welcome back, %s." (.SignedUser.ShortName 40)}}
      {{if .ContextUser.IsOrganization}}{{$introTitle = printf "%s’s workbench." (.ContextUser.ShortName 40)}}{{end}}
      {{template "custom/soda/page_intro" dict "TitleID" "soda-dashboard-title" "Eyebrow" "Your workbench" "Title" $introTitle "Description" "Pick up where you left off." "Class" "soda-page-intro--compact"}}
        {{template "base/alert" .}}
        <div class="soda-dashboard-heading soda-toolbar soda-toolbar--plain soda-p-toolbar">
          <div><h2 id="soda-activity-title">Activity</h2><p>The latest from your corner of the forge.</p></div>
          <div class="soda-context-switcher">{{template "user/dashboard/navbar" .}}</div>
        </div>
        {{template "user/heatmap" .}}
        {{if .Feeds}}{{template "user/dashboard/feeds" .}}{{else}}{{template "user/dashboard/guide" .}}{{end}}
      </section>
      <aside class="soda-dashboard-sidebar" aria-label="Repositories and organizations">
      <img class="soda-dashboard-art" src="{{AssetUrlPrefix}}/soda/forgejo/dashboard-papercraft.png" alt="" width="1536" height="1024">
        {{template "user/dashboard/repolist" .}}
        <section class="soda-dashboard-discover">
          {{svg "octicon-telescope" 24}}
          <h2>Find something to build.</h2>
          <p>A new idea could be one repository away.</p>
          <a href="{{AppSubUrl}}/explore/repos">Explore repositories {{svg "octicon-arrow-right" 16}}</a>
        </section>
      </aside>
    </div>
  </div>
</div>
{{end}}
{{template "base/footer" .}}
