{{/* Soda login presentation for stock Forgejo 15.0.7. Native authentication is rendered unchanged by signin_inner. */}}
{{template "base/head" .}}
<main aria-label="{{.Title}}" class="page-content user signin soda-login{{if .LinkAccountMode}} icon{{end}}">
	<button id="soda-theme-toggle" class="soda-theme-toggle" type="button" aria-label="Switch theme" hidden>
		<svg class="soda-theme-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4L19 5"/></svg>
		<svg class="soda-theme-moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.3A8.7 8.7 0 0 1 10.7 3.5 8.7 8.7 0 1 0 20.5 13.3Z"/></svg>
	</button>
	<section class="soda-login-story" aria-label="Soda OS">
		<a class="soda-login-brand" href="{{AppSubUrl}}/" aria-label="Soda OS home">
			<img class="soda-login-logo-light" src="{{AssetUrlPrefix}}/soda/source/soda-logo-horizontal.svg" width="156" height="42" alt="Soda OS">
			<img class="soda-login-logo-dark" src="{{AssetUrlPrefix}}/soda/source/soda-logo-horizontal-dark.svg" width="156" height="42" alt="Soda OS">
		</a>
		<div class="soda-login-art">
			<h1>Development goes<br>better with Soda.</h1>
			<img src="{{AssetUrlPrefix}}/soda/forgejo/login-papercraft.png" width="1536" height="1024" alt="A friendly papercraft robot welcomes you beside a mint development computer, laptop and glass of soda.">
		</div>
		<p class="soda-login-tagline">Your projects. Your tools. Your Soda.</p>
	</section>
	<section class="soda-login-panel" aria-label="{{ctx.Locale.Tr "sign_in"}}">
		<div class="soda-login-form">
			{{if not .LinkAccountMode}}
			<p class="soda-login-eyebrow">Your development cloud</p>
			<h2>Welcome back.</h2>
			<p class="soda-login-intro">Sign in to your Soda workspace.</p>
			{{end}}
			{{template "user/auth/signin_inner" .}}
			{{if not .ShowRegistrationButton}}<p class="soda-login-account">Need an account? Contact your administrator.</p>{{end}}
		</div>
	</section>
</main>
{{template "base/footer" .}}
