{{/* Adapted presentation wrapper from stock Forgejo 15.0.7; GPL-3.0-or-later. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content ui one column stackable center aligned page grid oauth2-authorize-application-box soda-page soda-federated-auth soda-federated-auth--error {{if .IsRepo}}repository{{end}}" data-signed="{{if .IsSigned}}true{{else}}false{{end}}">
	{{if .IsRepo}}{{template "repo/header" .}}{{end}}
	<div class="column seven wide">
		<div class="ui middle centered raised segments">
			<h1 class="ui top attached header soda-p-title">
				{{ctx.Locale.Tr "auth.authorization_failed"}}
			</h1>
			<h3 class="ui attached segment">{{.Error.ErrorDescription}}</h3>
			<div class="ui attached segment soda-p-section">
				<p>{{ctx.Locale.Tr "auth.authorization_failed_desc"}}</p>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
