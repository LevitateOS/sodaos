{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content soda-page soda-auth soda-native-forms user activate" data-signed="{{if .IsSigned}}true{{else}}false{{end}}">
	{{if not .IsSigned}}{{template "custom/soda/theme_toggle" dict}}{{end}}
	<div class="ui middle very relaxed page grid">
		<div class="column">
			<form class="ui form tw-max-w-2xl tw-m-auto">
				<h2 class="ui top attached header">
					{{ctx.Locale.Tr "auth.prohibit_login"}}
				</h2>
				<div class="ui attached segment">
					<p>{{ctx.Locale.Tr "auth.prohibit_login_desc"}}</p>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
