{{/* Adapted from stock Forgejo 15.0.7; native owner navigation and package data remain authoritative. */}}
{{template "base/head" .}}
{{if .ContextUser.IsOrganization}}
	<main aria-label="{{.Title}}" class="page-content organization packages soda-page soda-packages soda-packages-index" data-signed="{{.IsSigned}}">
		{{template "org/header" .}}
		<div class="ui container soda-page-container">
			{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" "Package registry" "Title" (ctx.Locale.Tr "packages.title") "Description" "Published artifacts, ready for the next build." "Artwork" "organization-packages-papercraft.png" "Class" "soda-page-intro--compact"}}
			{{template "package/shared/list" .}}
		</div>
	</main>
{{else}}
	<main aria-label="{{.Title}}" class="page-content user profile packages soda-page soda-packages soda-packages-index" data-signed="{{.IsSigned}}">
		<div class="ui container soda-page-container">
			<div class="ui stackable grid">
				<div class="ui four wide column soda-profile-card-context">
					{{template "shared/user/profile_big_avatar" .}}
				</div>
				<div class="ui twelve wide column tw-mb-4">
					{{template "user/overview/header" .}}
					{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" "Package registry" "Title" (ctx.Locale.Tr "packages.title") "Description" "Published artifacts, ready for the next build." "Artwork" "personal-packages-papercraft.png" "Class" "soda-page-intro--compact"}}
					{{template "package/shared/list" .}}
				</div>
			</div>
		</div>
	</main>
{{end}}
{{template "base/footer" .}}
