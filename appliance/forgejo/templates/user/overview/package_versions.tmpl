{{/* Adapted from stock Forgejo 15.0.7; native owner navigation and version data remain authoritative. */}}
{{template "base/head" .}}
{{if .ContextUser.IsOrganization}}
	<main aria-label="{{.Title}}" class="page-content organization packages soda-page soda-packages soda-package-versions" data-signed="{{.IsSigned}}">
		{{template "org/header" .}}
		<div class="ui container soda-page-container">
			{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" .PackageDescriptor.Package.Name "Title" (ctx.Locale.Tr "packages.versions") "Description" "Every published version, in one place." "Class" "soda-page-intro--compact"}}
			{{template "package/shared/versionlist" .}}
		</div>
	</main>
{{else}}
	<main aria-label="{{.Title}}" class="page-content user profile packages soda-page soda-packages soda-package-versions" data-signed="{{.IsSigned}}">
		<div class="ui container soda-page-container">
			<div class="ui stackable grid">
				<div class="ui four wide column">
					{{template "shared/user/profile_big_avatar" .}}
				</div>
				<div class="ui twelve wide column tw-mb-4">
					{{template "user/overview/header" .}}
					{{template "custom/soda/page_intro" dict "TitleID" "soda-page-title" "Eyebrow" .PackageDescriptor.Package.Name "Title" (ctx.Locale.Tr "packages.versions") "Description" "Every published version, in one place." "Class" "soda-page-intro--compact"}}
					{{template "package/shared/versionlist" .}}
				</div>
			</div>
		</div>
	</main>
{{end}}
{{template "base/footer" .}}
