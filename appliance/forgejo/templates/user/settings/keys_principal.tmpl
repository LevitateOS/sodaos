{{/* Adapted from Forgejo 15.0.7 templates/user/settings/keys_principal.tmpl (GPL-3.0-or-later); upstream SHA-256 1e8f51c47e15c7cbdc031053588edb6b87c936b8aa31b709ff00fce41182fc24. */}}
{{if .AllowPrincipals}}
	<h2 class="soda-settings-inventory-heading soda-p-heading">
		{{ctx.Locale.Tr "settings.manage_ssh_principals"}}
		<div class="ui right">
		{{if not .DisableSSH}}
			<button class="ui primary tiny show-panel button soda-p-compact" data-panel="#add-ssh-principal-panel">{{ctx.Locale.Tr "settings.add_new_principal"}}</button>
		{{else}}
			<button class="ui primary tiny button disabled soda-p-compact">{{ctx.Locale.Tr "settings.ssh_disabled"}}</button>
		{{end}}
		</div>
	</h2>
	<div class="ui attached segment soda-p-section">
		<div class="flex-list">
			{{if not .Principals}}<div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-key" "Title" (ctx.Locale.Tr "repo.issues.filter_no_results") "Description" (ctx.Locale.Tr "settings.principal_desc")}}</div>{{else}}<div class="flex-item">
				{{ctx.Locale.Tr "settings.principal_desc"}}
			</div>{{end}}
			{{range .Principals}}
				<div class="flex-item">
					<div class="flex-item-leading">
						<span class="text {{if .HasRecentActivity}}green{{end}}" {{if .HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.principal_state_desc"}}"{{end}}>{{svg "octicon-key" 32}}</span>
					</div>
					<div class="flex-item-main">
						<div class="flex-item-title">{{.Name}}</div>
						<div class="flex-item-body">
							<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}} —  {{svg "octicon-info" 16}} {{if .HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .HasRecentActivity}}class="green"{{end}}>{{DateUtils.AbsoluteShort .UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}</p>
						</div>
					</div>
					<div class="flex-item-trailing">
						<button class="ui red tiny button delete-button soda-p-compact" data-modal-id="delete-principal" data-url="{{$.Link}}/delete?type=principal" data-id="{{.ID}}">
							{{ctx.Locale.Tr "settings.delete_key"}}
						</button>
					</div>
				</div>
			{{end}}
		</div>
	</div>
	<br>

	<div {{if not .HasPrincipalError}}class="tw-hidden"{{end}} id="add-ssh-principal-panel">
		<h2 class="soda-settings-inventory-heading soda-p-heading">
			{{ctx.Locale.Tr "settings.add_new_principal"}}
		</h2>
		<div class="ui attached segment soda-p-section">
			<form class="ui form soda-p-form" action="{{.Link}}" method="post">
				<div class="field {{if .Err_Content}}error{{end}}">
					<label for="ssh-principal-content">{{ctx.Locale.Tr "settings.principal_content"}}</label>
					<input id="ssh-principal-content" name="content" value="{{.content}}" required>
				</div>
				<input name="title" type="hidden" value="principal">
				<input name="type" type="hidden" value="principal">
				<button class="ui primary button soda-p-control">
					{{ctx.Locale.Tr "settings.add_new_principal"}}
				</button>
			</form>
		</div>
	</div>

	<div class="ui g-modal-confirm delete modal" id="delete-principal">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.ssh_principal_deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.ssh_principal_deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
{{end}}
