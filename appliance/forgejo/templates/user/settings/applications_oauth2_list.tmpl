{{/* Adapted from Forgejo 15.0.7 templates/user/settings/applications_oauth2_list.tmpl (GPL-3.0-or-later); upstream SHA-256 fef3276344cd83d2df9a074ff37eafb320b2835de59d951add2601672d53c761. */}}
{{if .PersonalSettings}}{{template "user/settings/applications_oauth2_list_body" .}}{{else}}{{template "user/settings/applications_oauth2_list_body" (dict "ctxData" .)}}{{end}}
{{define "user/settings/applications_oauth2_list_body"}}{{$personal := .PersonalSettings}}{{$ := .ctxData}}{{with .ctxData}}
<div class="ui attached segment soda-p-section">
	<div class="flex-list">
		{{if and $personal (not .Applications)}}<div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-apps" "Title" (ctx.Locale.Tr "repo.issues.filter_no_results") "Description" (ctx.Locale.Tr "settings.oauth2_application_create_description")}}</div>{{else}}<div class="flex-item">
			{{ctx.Locale.Tr "settings.oauth2_application_create_description"}}
		</div>{{end}}
		{{range .Applications}}
			<div class="flex-item tw-items-center">
				<div class="flex-item-leading">
					{{svg "octicon-apps" 32}}
				</div>
				<div class="flex-item-main">
					<div class="flex-item-title">{{.Name}}</div>
					<div class="flex-item-body">
						{{ctx.Locale.Tr "settings.oauth2_client_id"}}
						<span class="ui label">{{.ClientID}}</span>
					</div>
				</div>
				{{$isBuiltin := and $.BuiltinApplications (index $.BuiltinApplications .ClientID)}}
				<div class="flex-item-trailing">
					{{if $isBuiltin}}
						<span class="ui basic label" data-tooltip-content="{{ctx.Locale.Tr "settings.oauth2_application_locked"}}">{{ctx.Locale.Tr "locked"}}</span>
					{{else}}
						<a href="{{$.Link}}/oauth2/{{.ID}}" class="ui primary tiny button{{if $personal}} soda-p-compact{{end}}">
							{{svg "octicon-pencil" 16 "tw-mr-1"}}
							{{ctx.Locale.Tr "settings.oauth2_application_edit"}}
						</a>
						<button class="ui red tiny button delete-button{{if $personal}} soda-p-compact{{end}}" data-modal-id="remove-gitea-oauth2-application"
								data-url="{{$.Link}}/oauth2/{{.ID}}/delete">
							{{svg "octicon-trash" 16 "tw-mr-1"}}
							{{ctx.Locale.Tr "settings.delete_key"}}
						</button>
					{{end}}
				</div>
			</div>
		{{end}}
	</div>

	<div class="ui g-modal-confirm delete modal" id="remove-gitea-oauth2-application">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.remove_oauth2_application"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.oauth2_application_remove_description"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>

{{if $personal}}<details id="oauth-registration" class="soda-settings-disclosure" data-settings-editor open><summary>{{ctx.Locale.Tr "settings.create_oauth2_application"}}</summary>{{end}}
<div class="{{if $personal}}soda-settings-editor soda-settings-disclosure-body{{else}}ui attached bottom segment soda-p-section{{end}}">
{{if not $personal}}<h5 class="ui top header">{{ctx.Locale.Tr "settings.create_oauth2_application"}}</h5>{{end}}
	<form class="soda-form-panel ui form soda-form ignore-dirty{{if $personal}} soda-p-form{{end}}" action="{{.Link}}/oauth2" method="post">
		<div class="field {{if .Err_AppName}}error{{end}}">
			<label for="application-name">{{ctx.Locale.Tr "settings.oauth2_application_name"}}</label>
			<input id="application-name" name="application_name" value="{{.application_name}}" required maxlength="255">
		</div>
		<div class="field {{if .Err_RedirectURI}}error{{end}}">
			<label for="redirect-uris">{{ctx.Locale.Tr "settings.oauth2_redirect_uris"}}</label>
			<textarea name="redirect_uris" id="redirect-uris" required></textarea>
		</div>
		<div class="field {{if .Err_ConfidentialClient}}error{{end}}">
			<div class="ui checkbox">
				<label>{{ctx.Locale.Tr "settings.oauth2_confidential_client"}}</label>
				<input type="checkbox" name="confidential_client" checked>
			</div>
		</div>
		<button class="ui primary button soda-p-control">
			{{ctx.Locale.Tr "settings.create_oauth2_application_button"}}
		</button>
	</form>
</div>

{{if $personal}}</details>{{end}}

{{end}}{{end}}
