{{/* Adapted from Forgejo 15.0.7 templates/user/settings/grants_oauth2.tmpl (GPL-3.0-or-later); upstream SHA-256 1d1f59a13b3676b5924869b559cc590690f306456222efb45e0f646fdc79eac6. */}}
<h2 class="soda-settings-inventory-heading soda-p-heading">
	{{ctx.Locale.Tr "settings.authorized_oauth2_applications"}}
</h2>
<div class="ui attached segment soda-p-section">
	<div class="flex-list">
		{{if not .Grants}}<div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-key" "Title" (ctx.Locale.Tr "repo.issues.filter_no_results")}}</div>{{else}}<div class="flex-item">
			{{ctx.Locale.Tr "settings.authorized_oauth2_applications_description"}}
		</div>{{end}}
		{{range .Grants}}
			<div class="flex-item">
				<div class="flex-item-leading">
					{{svg "octicon-key" 32}}
				</div>
				<div class="flex-item-main">
					<div class="flex-item-title">{{.Application.Name}}</div>
					<div class="flex-item-body">
						<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}}</p>
					</div>
				</div>
				<div class="flex-item-trailing">
					<button class="ui red tiny button delete-button soda-p-compact" data-modal-id="revoke-gitea-oauth2-grant"
							data-url="{{AppSubUrl}}/user/settings/applications/oauth2/{{.ApplicationID}}/revoke/{{.ID}}">
						{{ctx.Locale.Tr "settings.revoke_key"}}
					</button>
				</div>
			</div>
		{{end}}
	</div>

	<div class="ui g-modal-confirm delete modal" id="revoke-gitea-oauth2-grant">
		<div class="header">
			{{svg "octicon-shield" 16 "tw-mr-1"}}
			{{ctx.Locale.Tr "settings.revoke_oauth2_grant"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.revoke_oauth2_grant_description"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
