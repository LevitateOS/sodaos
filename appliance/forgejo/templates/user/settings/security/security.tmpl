{{/* Adapted from Forgejo 15.0.7 templates/user/settings/security/security.tmpl (GPL-3.0-or-later); upstream SHA-256 a5fbae07bc6d439c451bcf2eaaa333d4dcfc358025918158c1f7bbc60fb7db8c. */}}
{{template "user/settings/layout_head" (dict "ctxData" . "pageClass" "user settings soda-account-details-page soda-account-details-page--security security" "HideNavbarLinks" .HideNavbarLinks)}}
	<div class="user-setting-content soda-account-details soda-account-details--security">
		{{if .MustEnableTwoFactor}}
			<div class="ui red message">{{ctx.Locale.Tr "settings.must_enable_2fa"}}</div>
		{{end}}
		{{template "user/settings/security/twofa" .}}
		{{template "user/settings/security/webauthn" .}}
		{{if not .MustEnableTwoFactor}}
<section class="soda-settings-section"><h2>{{ctx.Locale.Tr "password"}}</h2><div><p>{{ctx.Locale.Tr "soda.security_password"}}</p><a href="{{AppSubUrl}}/user/settings/account#password">{{ctx.Locale.Tr "settings.change_password"}} {{svg "octicon-arrow-right" 16}}</a></div></section>
			{{template "user/settings/security/accountlinks" .}}
			{{if .EnableOpenIDSignIn}}
				{{template "user/settings/security/openid" .}}
			{{end}}
		{{end}}
	</div>

{{template "user/settings/layout_footer" .}}
