{{/* Adapted from Forgejo 15.0.7 templates/user/settings/security/twofa.tmpl (GPL-3.0-or-later); upstream SHA-256 7b43a4250f4e56f59a35f4f8b511f4f4183035fc92e7feba53656803ec3d886d. */}}

<section class="soda-settings-section "><h2>
	{{ctx.Locale.Tr "settings.twofa"}}
</h2><div class="soda-settings-section-body">
<div class="soda-settings-section-body">
	
	{{if .TOTPEnrolled}}
	<p class="soda-factor-state">{{ctx.Locale.Tr "settings.twofa_is_enrolled"}}</p><p>{{ctx.Locale.Tr "settings.twofa_desc"}}</p>
	<div class="inline field">
		<p>{{ctx.Locale.Tr "settings.twofa_reenroll.description"}}</p>
		<a class="ui primary button soda-p-control" href="{{AppSubUrl}}/user/settings/security/two_factor/reenroll">{{ctx.Locale.Tr "settings.twofa_reenroll"}}</a>
	</div>
	<form class="ui form soda-p-form" action="{{AppSubUrl}}/user/settings/security/two_factor/regenerate_scratch" method="post" enctype="multipart/form-data">
		<p>{{ctx.Locale.Tr "settings.regenerate_scratch_token_desc"}}</p>
		<button class="ui primary button soda-p-control">{{ctx.Locale.Tr "settings.twofa_scratch_token_regenerate"}}</button>
	</form>
	{{if .SignedUser.MustHaveTwoFactor}}
		<p class="tw-mt-4 tw-mb-0">{{ctx.Locale.Tr "settings.twofa_unroll_unavailable"}}</p>
	{{else}}
		<form class="ui form soda-p-form" action="{{AppSubUrl}}/user/settings/security/two_factor/disable" method="post" enctype="multipart/form-data" id="disable-form">
			<p>{{ctx.Locale.Tr "settings.twofa_disable_note"}}</p>
			<button class="ui red button delete-button soda-p-control" data-modal-id="disable-twofa" data-type="form" data-form="#disable-form">{{ctx.Locale.Tr "settings.twofa_disable"}}</button>
		</form>
	{{end}}
	{{else}}
	{{/* The recovery tip is there as a means of encouraging a user to enroll */}}
	
	<p class="soda-factor-state">{{ctx.Locale.Tr "settings.twofa_not_enrolled"}}</p>
	<div class="inline field">
<p>{{ctx.Locale.Tr "settings.twofa_desc"}}</p><p class="ui warning message soda-notice">{{ctx.Locale.Tr "settings.twofa_recovery_tip"}}</p>
		<a class="ui primary button soda-p-control" href="{{AppSubUrl}}/user/settings/security/two_factor/enroll">{{ctx.Locale.Tr "settings.twofa_enroll"}}</a>
	</div>
	{{end}}

	<div class="ui g-modal-confirm delete modal" id="disable-twofa">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.twofa_disable"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.twofa_disable_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>

</div></section>
