{{/* Adapted from Forgejo 15.0.7 templates/user/settings/keys_ssh.tmpl (GPL-3.0-or-later); upstream SHA-256 4ae989aa229871aad84271593aaeae6f53d76208cad1491aadf70d0188bb3b73. */}}
<h2 class="soda-settings-inventory-heading soda-p-heading">
	{{ctx.Locale.Tr "settings.manage_ssh_keys"}}
	<div class="ui right">
		<button id="add-ssh-button" class="ui primary tiny show-panel toggle button soda-p-compact" data-panel="#add-ssh-key-panel">
			{{ctx.Locale.Tr "settings.add_key"}}
		</button>
	</div>
</h2>
<div class="ui attached segment soda-p-section">
	<div class="{{if not .HasSSHError}}tw-hidden{{end}} tw-mb-4" id="add-ssh-key-panel">
		<form class="soda-form-panel ui form soda-p-form" action="{{.Link}}" method="post">
			<div class="field {{if .Err_Title}}error{{end}}">
				<label for="ssh-key-title">{{ctx.Locale.Tr "settings.key_name"}}</label>
				<input id="ssh-key-title" name="title" value="{{.title}}" required maxlength="50">
			</div>
			<div class="field {{if .Err_Content}}error{{end}}">
				<label for="ssh-key-content">{{ctx.Locale.Tr "settings.key_content"}}</label>
				<textarea id="ssh-key-content" name="content" class="js-quick-submit" placeholder="{{ctx.Locale.Tr "settings.key_content_ssh_placeholder"}}" required>{{.content}}</textarea>
			</div>
			<input name="type" type="hidden" value="ssh">
			<button class="ui primary button soda-p-control">
				{{ctx.Locale.Tr "settings.add_key"}}
			</button>
			<button id="cancel-ssh-button" class="ui hide-panel button soda-p-control" data-panel="#add-ssh-key-panel">
				{{ctx.Locale.Tr "cancel"}}
			</button>
		</form>
	</div>
	<div id="keys-ssh" class="flex-list">
		{{if not .Keys}}<div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-key" "Title" (ctx.Locale.Tr "repo.issues.filter_no_results") "Description" (ctx.Locale.Tr "settings.ssh_desc")}}<p class="soda-empty-description">{{ctx.Locale.Tr "settings.ssh_helper" "https://docs.codeberg.org/security/ssh-key/" "https://docs.github.com/en/free-pro-team@latest/github/authenticating-to-github/troubleshooting-ssh"}}</p></div>{{else}}<div class="flex-item">
			<p>
				{{ctx.Locale.Tr "settings.ssh_desc"}}<br>
				{{ctx.Locale.Tr "settings.ssh_helper" "https://docs.codeberg.org/security/ssh-key/" "https://docs.github.com/en/free-pro-team@latest/github/authenticating-to-github/troubleshooting-ssh"}}
			</p>
		</div>{{end}}
		{{if .DisableSSH}}
			<div class="ui info message soda-notice">
				{{ctx.Locale.Tr "settings.ssh_signonly"}}
			</div>
		{{end}}
		{{range $index, $key := .Keys}}
			<div class="flex-item">
				<div class="flex-item-leading">
					<span class="text {{if .HasRecentActivity}}green{{end}}" {{if .HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.key_state_desc"}}"{{end}}>{{svg "octicon-key" 32}}</span>
				</div>
				<div class="flex-item-main">
						{{if .Verified}}
							<div class="flex-item-title flex-text-block" data-tooltip-content="{{ctx.Locale.Tr "settings.ssh_key_verified_long"}}">{{svg "octicon-verified"}}{{ctx.Locale.Tr "settings.ssh_key_verified"}}</div>
						{{end}}
						<div class="flex-item-title">{{.Name}}</div>
						<div class="flex-item-body">
								{{.Fingerprint}}
						</div>
						<div class="flex-item-body">
								<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}} —	{{svg "octicon-info"}} {{if .HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort .UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}</p>
						</div>
				</div>
				<div class="flex-item-trailing">
					<button class="ui red tiny button delete-button{{if index $.ExternalKeys $index}} disabled{{end}} soda-p-compact" data-modal-id="delete-ssh" data-url="{{$.Link}}/delete?type=ssh" data-id="{{.ID}}"{{if index $.ExternalKeys $index}} title="{{ctx.Locale.Tr "settings.ssh_externally_managed"}}"{{end}}>
						{{ctx.Locale.Tr "settings.delete_key"}}
					</button>
					{{if and (not .Verified) (ne $.VerifyingFingerprint .Fingerprint)}}
						<a class="ui primary tiny button soda-p-compact" href="?verify_ssh={{.Fingerprint}}">{{ctx.Locale.Tr "settings.ssh_key_verify"}}</a>
					{{end}}
				</div>
			</div>
			{{if and (not .Verified) (eq $.VerifyingFingerprint .Fingerprint)}}
				<div class="ui segment">
					<h2>{{ctx.Locale.Tr "settings.ssh_token_required"}}</h2>
					<form class="soda-form-panel ui form{{if $.HasSSHVerifyError}} error{{end}} soda-p-form" action="{{$.Link}}" method="post">
						<input type="hidden" name="title" value="none">
						<input type="hidden" name="content" value="{{.Content}}">
						<input type="hidden" name="fingerprint" value="{{.Fingerprint}}">
						<div class="field">
							<label for="token">{{ctx.Locale.Tr "settings.ssh_token"}}</label>
							<input readonly="" value="{{$.TokenToSign}}">
							<span class="help">{{ctx.Locale.Tr "keys.verify.token.hint" (printf "?verify_ssh=%s" (QueryEscape .Fingerprint))}}</span>
							<div class="help">
								<br>
								<p>{{ctx.Locale.Tr "settings.ssh_token_help"}}</p>
								<div class="markup"><pre class="code-block"><code>echo -n '{{$.TokenToSign}}' | ssh-keygen -Y sign -n {{AppDomain}} -f ~/.ssh/id_ed25519 # or the path to the private key if it is different.</code></pre></div>
								<br>
								<p>{{ctx.Locale.Tr "settings.ssh_token_help_ssh_agent"}}</p>
								<div class="markup"><pre class="code-block"><code>bash -c "echo -n '{{$.TokenToSign}}' | ssh-keygen -Y sign -n {{AppDomain}} -f <(echo '{{.OmitEmail}}')"</code></pre></div>
								<br>
								<details>
									<summary>Windows PowerShell</summary>
									<div class="markup"><pre class="code-block"><code>cmd /c "&lt;NUL set /p=`"{{$.TokenToSign}}`"| ssh-keygen -Y sign -n {{AppDomain}} -f /path_to_PrivateKey_or_RelatedPublicKey"</code></pre></div>
								</details>
								<br>
								<details>
									<summary>Windows CMD</summary>
									<div class="markup"><pre class="code-block"><code>&lt;NUL set /p="{{$.TokenToSign}}"| ssh-keygen -Y sign -n {{AppDomain}} -f /path_to_PrivateKey_or_RelatedPublicKey</code></pre></div>
								</details>
							</div>
							<br>
						</div>
						<div class="field">
							<label for="signature">{{ctx.Locale.Tr "settings.ssh_token_signature"}}</label>
							<textarea id="ssh-key-signature" name="signature" class="js-quick-submit" placeholder="{{ctx.Locale.Tr "settings.key_signature_ssh_placeholder"}}" required>{{$.signature}}</textarea>
						</div>
						<input name="type" type="hidden" value="verify_ssh">
						<button class="ui primary button soda-p-control">
							{{ctx.Locale.Tr "settings.ssh_key_verify"}}
						</button>
						<a class="ui red button soda-p-control" href="{{$.Link}}">
							{{ctx.Locale.Tr "settings.cancel"}}
						</a>
					</form>
				</div>
			{{end}}
		{{end}}
	</div>
	<div class="ui g-modal-confirm delete modal" id="delete-ssh">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.ssh_key_deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.ssh_key_deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
