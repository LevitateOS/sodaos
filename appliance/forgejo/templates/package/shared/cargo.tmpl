<div class="ui form soda-form">
	<fieldset class="soda-form-section soda-p-section">
		<legend>{{ctx.Locale.Tr "packages.owner.settings.cargo.title"}}</legend>
		<div class="field">
			<label>{{ctx.Locale.Tr "packages.registry.documentation" "Cargo" "https://forgejo.org/docs/latest/user/packages/cargo/"}}</label>
		</div>
        {{$description := printf "%s" (ctx.Locale.Tr "packages.owner.settings.cargo.initialize.description")}}
        {{if .CargoIndexExists}}{{$description = printf "%s" (ctx.Locale.Tr "packages.owner.settings.cargo.rebuild.description")}}{{end}}
        {{/* The pinned English catalog combines context and warning. Preserve other
             translations intact until their sentence boundaries are reviewed. */}}
        {{$sentences := StringUtils.Split $description ". "}}
        {{if and (eq ctx.Locale.Lang "en-US") (eq (len $sentences) 2)}}
        <div class="ui info message soda-notice">{{index $sentences 0}}.</div>
        <div class="ui warning message soda-notice">{{index $sentences 1}}</div>
        {{else}}
        <div class="ui warning message soda-notice">{{$description}}</div>
        {{end}}
        {{if .CargoIndexExists}}
        <form class="field" action="{{.Link}}/cargo/rebuild" method="post">
            <button class="ui primary button">{{ctx.Locale.Tr "packages.owner.settings.cargo.rebuild"}}</button>
        </form>
        {{else}}
        <form class="field" action="{{.Link}}/cargo/initialize" method="post">
            <button class="ui primary button">{{ctx.Locale.Tr "packages.owner.settings.cargo.initialize"}}</button>
        </form>
        {{end}}
    </fieldset>
</div>
