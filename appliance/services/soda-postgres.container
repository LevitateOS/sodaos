[Unit]
Description=Soda appliance PostgreSQL 17 (Forgejo and Soda stores)
After=network-online.target
Wants=network-online.target
# First boot provisions secrets through this dependency. The provision unit
# gates itself on the install stamp, so live media skips the dependency and
# this condition keeps skipping here exactly as before.
Requires=soda-pg-provision.service
After=soda-pg-provision.service
ConditionPathExists=/etc/soda/postgres/super.passwd

[Container]
Image=docker.io/library/postgres:17@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675
ContainerName=soda-postgres
Pull=missing
Network=soda.network
# No PublishPort: no database TCP reaches the host. Host-network and native
# clients (dashboard, identity broker) connect through the shared unix
# socket below; Forgejo uses TCP inside the appliance container network.
# Host operators reach it through the backup/restore tools, which use
# podman exec with container-local peer authentication.
Volume=/var/lib/soda/postgres:/var/lib/postgresql/data:Z
Volume=/run/soda/postgres:/var/run/postgresql:z
Volume=/etc/soda/postgres/super.passwd:/run/secrets/soda-pg-super:ro,Z
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/soda-pg-super
# Only the superuser password is mounted here: the entrypoint reads it as
# root. Role/database creation is soda-postgres-init.service, which runs as
# root with container-local peer auth; app-role passwords stay in mode-0600
# root-only files under /etc/soda/postgres and never enter the DB container.

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
