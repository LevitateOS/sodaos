[Unit]
Description=Soda identity administration socket
After=systemd-tmpfiles-setup.service
ConditionPathExists=/etc/soda/identity.json

[Socket]
ListenStream=/run/soda/identity/admin.sock
FileDescriptorName=admin
SocketUser=soda-identity
SocketGroup=soda
SocketMode=0660
Service=soda-identity.service

[Install]
WantedBy=sockets.target
