[Unit]
Description=Persistent Soda project %i
After=network-online.target soda-host.service
Wants=network-online.target soda-host.service

[Service]
Type=simple
ExecStart=/usr/bin/podman start --attach soda-%i
ExecStartPost=/usr/local/libexec/soda/soda-muse-maintain --bind-only --project %i
ExecStartPost=/usr/local/libexec/soda/soda-muse-maintain --bind-only --git-only --project %i
# Queue only; enrollment never waits inside the helper's project admission gate.
ExecStartPost=-/usr/bin/systemctl --no-block start soda-tailnet@%i.service
ExecStop=/usr/bin/podman stop --time 30 soda-%i
Restart=on-failure
TimeoutStopSec=60
KillMode=none

[Install]
WantedBy=multi-user.target
