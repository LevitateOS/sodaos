{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds soda-page soda-dashboard" data-signed="true">
  <div class="soda-page-container">
    <div class="soda-dashboard-grid">
      <section class="soda-dashboard-feed soda-list" aria-labelledby="soda-activity-title">
      {{$introTitle := printf "Welcome back, %s." (.SignedUser.ShortName 40)}}
      {{if .ContextUser.IsOrganization}}{{$introTitle = printf "%s’s workbench." (.ContextUser.ShortName 40)}}{{end}}
      {{template "custom/soda/page_intro" dict "TitleID" "soda-dashboard-title" "Eyebrow" "Software collaboration" "Title" $introTitle "Description" "Inspect issues, pull requests, reviews and CI. Your team decides what merges." "Class" "soda-page-intro--compact"}}
        {{template "base/alert" .}}
        <div class="soda-dashboard-heading soda-toolbar soda-toolbar--plain soda-p-toolbar">
          <div><h2 id="soda-activity-title">Activity</h2><p>The latest from your corner of the forge.</p></div>
          <div class="soda-context-switcher">{{template "user/dashboard/navbar" .}}</div>
        </div>
        {{template "user/heatmap" .}}
        {{if .Feeds}}{{template "user/dashboard/feeds" .}}{{else}}{{template "user/dashboard/guide" .}}{{end}}
      </section>
      <aside class="soda-dashboard-sidebar" aria-label="Repositories and organizations">
        {{template "user/dashboard/repolist" .}}
        <section class="soda-dashboard-discover">
          {{svg "octicon-telescope" 24}}
          <h2>Find something to build.</h2>
          <p>A new idea could be one repository away.</p>
          <a href="{{AppSubUrl}}/explore/repos">Explore repositories {{svg "octicon-arrow-right" 16}}</a>
        </section>
      </aside>
    </div>
  </div>
</div>
{{template "base/footer" .}}
