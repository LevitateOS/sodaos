{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository view issue pull commits soda-repo-thread soda-pull-commits">
	{{template "repo/header" .}}
	<div class="ui container soda-repo-thread-container">
		<div class="soda-repo-thread-title">{{template "repo/issue/view_title" .}}</div>
		{{template "repo/pulls/tab_menu" .}}
		<div class="soda-pull-commits-list">{{template "repo/commits_table" .}}</div>
	</div>
</div>
{{template "base/footer" .}}
