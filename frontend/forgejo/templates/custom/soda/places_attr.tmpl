{{- /* Current repository places share the /feed route tree. */ -}}
{{- $p := .Page -}}{{- $part := .Part -}}
{{- $soda := "" -}}{{- $sodaExtension := "" -}}
{{- with $p.ExtensionPages}}{{range index . "repository"}}{{if and (eq .ID "repository-feed") (eq .URL (print $p.RepoLink "/feed"))}}{{$soda = .URL}}{{$sodaExtension = .ExtensionID}}{{end}}{{end}}{{end -}}
{{- $here := $p.ExtensionPageURL -}}{{- if and (not $here) $p.PageIsExtension}}{{$here = $p.Link}}{{end -}}
{{- $feed := $soda -}}{{- $requests := "" -}}{{- $app := "" -}}{{- $terminals := "" -}}{{- $knowledge := "" -}}{{- $settings := "" -}}{{- $issues := "" -}}{{- $pulls := "" -}}{{- $factory := "" -}}
{{- if $soda -}}
{{- $requests = print $soda "/requests"}}{{$app = print $soda "/app"}}{{$terminals = print $soda "/terminals"}}{{$knowledge = print $soda "/knowledge"}}{{$settings = print $soda "/settings"}}{{$issues = print $soda "/work/issues"}}{{$pulls = print $soda "/work/pulls" -}}
{{- with $p.Issue}}{{$factory = print $soda "/work/issues/" .Index "?tab=factory"}}{{end -}}
{{- end -}}
{{- if eq $part "issues-active" -}}
	{{- if and $issues (or (eq $here $issues) (StringUtils.HasPrefix $here (print $issues "/")))}}active {{end -}}
{{- else if eq $part "issues-url" -}}
  {{- if $issues}}{{$issues}}{{else}}{{$p.RepoLink}}/issues{{end -}}
{{- else if eq $part "pulls-active" -}}
	{{- if and $pulls (or (eq $here $pulls) (StringUtils.HasPrefix $here (print $pulls "/")))}}active {{end -}}
{{- else if eq $part "pulls-url" -}}
  {{- if $pulls}}{{$pulls}}{{else}}{{$p.RepoLink}}/pulls{{end -}}
{{- else if eq $part "settings-active" -}}
	{{- if and $settings (StringUtils.HasPrefix $here $settings)}}active {{end -}}
{{- end -}}
