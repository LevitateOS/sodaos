{{/* Presentation inputs only. Callers retain native context, translations and permission gates. */}}
<section class="soda-page-intro{{with .Class}} {{.}}{{end}}"{{with .TitleID}} aria-labelledby="{{.}}"{{end}}>
  <div class="soda-page-copy">
    {{with .Eyebrow}}<p class="soda-page-eyebrow">{{.}}</p>{{end}}
    <h1 class="soda-page-title"{{with .TitleID}} id="{{.}}"{{end}}>{{.Title}}</h1>
    {{with .Description}}<p class="soda-page-description">{{.}}</p>{{end}}
  </div>
</section>
