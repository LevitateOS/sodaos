{{/* Guest appearance follows the selected native theme on every page.
     Standalone entry screens already render their own toggle. */}}
{{$page := .Page}}
{{if and (not $page.IsSigned) (StringUtils.HasPrefix (ThemeName $page.SignedUser) "soda-")}}
	{{if eq .Placement "head"}}
		<script src="{{AssetUrlPrefix}}/soda/forgejo/login-theme.js?v=3" data-app-sub-url="{{AppSubUrl}}"></script>
	{{else if and (eq .Placement "navbar") (not (or $page.PageIsHome $page.PageIsSignIn $page.LinkAccountMode $page.PageIsInstall))}}
		{{template "custom/soda/theme_toggle" dict}}
	{{end}}
{{end}}
