{{if .PersonalSettings}}{{template "package/shared/cleanup_rules/preview_body" .}}{{else}}{{template "package/shared/cleanup_rules/preview_body" (dict "ctxData" .)}}{{end}}
{{define "package/shared/cleanup_rules/preview_body"}}{{$personal := .PersonalSettings}}{{$ := .ctxData}}{{with .ctxData}}
<section class="soda-package-section soda-package-cleanup-preview">
{{if not $personal}}<h4 class="ui top attached header soda-package-section-heading">{{ctx.Locale.Tr "packages.owner.settings.cleanuprules.preview"}}</h4>{{end}}
<div class="ui attached segment soda-package-section-body soda-p-section">
	<p>{{ctx.Locale.Tr "packages.owner.settings.cleanuprules.preview.overview" (len .VersionsToRemove)}}</p>
</div>
{{if and $personal (not .VersionsToRemove)}}
<div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-package" "Description" (ctx.Locale.Tr "packages.owner.settings.cleanuprules.preview.none")}}</div>
{{else}}
<div class="ui attached table segment soda-package-preview-table">
	<table class="ui very basic striped table unstackable">
		<thead>
			<tr>
				<th>{{ctx.Locale.Tr "admin.packages.type"}}</th>
				<th>{{ctx.Locale.Tr "admin.packages.name"}}</th>
				<th>{{ctx.Locale.Tr "admin.packages.version"}}</th>
				<th>{{ctx.Locale.Tr "admin.packages.creator"}}</th>
				<th>{{ctx.Locale.Tr "admin.packages.size"}}</th>
				<th>{{ctx.Locale.Tr "admin.packages.published"}}</th>
			</tr>
		</thead>
		<tbody>
			{{range .VersionsToRemove}}
				<tr>
					<td>{{.Package.Type.Name}}</td>
					<td>{{.Package.Name}}</td>
					<td><a href="{{.VersionWebLink}}">{{.Version.Version}}</a></td>
					<td><a href="{{.Creator.HomeLink}}">{{.Creator.Name}}</a></td>
					<td>{{ctx.Locale.TrSize .CalculateBlobSize}}</td>
					<td>{{DateUtils.AbsoluteShort .Version.CreatedUnix}}</td>
				</tr>
			{{else}}
				<tr>
					<td colspan="6">{{ctx.Locale.Tr "packages.owner.settings.cleanuprules.preview.none"}}</td>
				</tr>
			{{end}}
		</tbody>
	</table>
</div>
{{end}}
</section>

{{end}}{{end}}
