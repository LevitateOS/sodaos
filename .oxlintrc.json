{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": "off",
    "no-control-regex": "off",
    "no-useless-escape": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".artifacts/**",
    ".local/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "tests/**",
        "scripts/**",
        "tools/**",
        "**/fixtures/**",
        "**/testdata/**"
      ],
      "rules": {
        "complexity": "off"
      }
    }
  ]
}
