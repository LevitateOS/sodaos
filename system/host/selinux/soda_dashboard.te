policy_module(soda_dashboard, 1.0)

gen_require(`
	type container_t;
	type container_file_t;
	type init_t;
	type unconfined_service_t;
	type http_cache_port_t;
	type ntop_port_t;
	type node_t;
')

# Give only the dashboard container its own SELinux domain. The image itself
# remains an ordinary confined container and keeps the container runtime's
# standard per-container labels and MCS isolation.
type soda_dashboard_file_t;
container_file(soda_dashboard_file_t)
container_domain_template(soda_dashboard, soda_dashboard)

# OCI layers and private bind mounts retain Podman's standard container_file_t
# type. The publisher creates and removes private Git scratch files; image
# and config mounts remain read-only. Git subprocesses keep the same domain,
# and MCS labels still isolate each container's private files.
manage_dirs_pattern(soda_dashboard_t, container_file_t, container_file_t)
manage_files_pattern(soda_dashboard_t, container_file_t, container_file_t)
allow soda_dashboard_t container_file_t:file { execute execute_no_trans map };
allow soda_dashboard_t container_file_t:lnk_file read;

# Git opens Podman's private /dev/null, which retains container_file_t and
# the dashboard's MCS label. Keep character-device access within that label.
allow soda_dashboard_t container_file_t:chr_file { getattr open read write };

# The shared PostgreSQL unix socket and dashboard-to-Forgejo extension socket
# use the existing :z container_file_t mount. Keep both cross-container IPC
# directions scoped to this dedicated dashboard process domain.
allow soda_dashboard_t container_file_t:sock_file { create getattr setattr unlink write };
allow soda_dashboard_t container_t:unix_stream_socket connectto;
allow container_t soda_dashboard_t:unix_stream_socket connectto;

# systemd owns this socket and recreates it with RemoveOnStop. A dedicated
# socket type preserves that lifecycle while granting the dashboard only the
# write needed to connect and the exact host daemon peer it currently uses.
type soda_host_socket_t;
files_type(soda_host_socket_t)

files_search_pids(soda_dashboard_t)
allow soda_dashboard_t soda_host_socket_t:sock_file write;
allow soda_dashboard_t unconfined_service_t:unix_stream_socket connectto;
allow soda_dashboard_t http_cache_port_t:tcp_socket name_bind;
allow soda_dashboard_t node_t:tcp_socket node_bind;

# The service observer resolves its native actor through Forgejo's loopback
# REST listener. Fedora labels the configured TCP port 3000 ntop_port_t.
allow soda_dashboard_t ntop_port_t:tcp_socket name_connect;

# The fixed design client (internal/factory/control/priority_typesafe.go)
# POSTs to https://api.typesafe.ai (TCP 443, http_port_t) with DNS
# resolution. The container template grants the domain no self socket or
# external connect permissions, so the client needs its own stream-socket
# use (subsuming the former standalone self listen allow),
# the http name_connect, and DNS resolution. No other egress changes.
allow soda_dashboard_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_connect_http_port(soda_dashboard_t)
sysnet_dns_name_resolve(soda_dashboard_t)

# systemd creates and removes this one socket as its socket unit starts and
# stops; it does not gain permission to relabel or manage other runtime files.
allow init_t soda_host_socket_t:sock_file { create getattr setattr unlink };

# The identity administration listener is separate from the owner-only
# runtime listener. Only this exact socket is labeled for dashboard access;
# both listeners' server process runs in unconfined_service_t.
type soda_identity_admin_socket_t;
files_type(soda_identity_admin_socket_t)
allow init_t soda_identity_admin_socket_t:sock_file { create getattr setattr unlink };
allow soda_dashboard_t soda_identity_admin_socket_t:sock_file { getattr write };

# The shared, stable maintenance directory inode fences durable Project
# reservations against privileged release activation. Dashboard may lock and
# enumerate it, and inspect marker metadata, without reading private journals.
type soda_project_maintenance_t;
files_type(soda_project_maintenance_t)
allow soda_dashboard_t soda_project_maintenance_t:dir { getattr open read search lock };
allow soda_dashboard_t soda_project_maintenance_t:file getattr;
allow soda_dashboard_t soda_project_maintenance_t:lnk_file getattr;
