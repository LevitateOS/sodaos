# Local host-content candidate, not yet an installable Soda release. The caller
# build context supplies the selected architecture-specific CoreOS image digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS selinux-policy-build

# Compile the appliance's targeted SELinux policy using this exact base's
# platform headers, without adding the policy development toolchain to the
# appliance package inventory.
COPY selinux/ /run/soda-build/selinux/
RUN rpm-ostree install selinux-policy-devel && \
    make -f /usr/share/selinux/devel/Makefile \
      -C /run/soda-build/selinux soda_dashboard.pp && \
    checkmodule -M -m -o /run/soda-build/selinux/soda_factory_io.mod \
      /run/soda-build/selinux/soda_factory_io.te && \
    semodule_package -o /run/soda-build/selinux/soda_factory_io.pp \
      -m /run/soda-build/selinux/soda_factory_io.mod \
      -f /run/soda-build/selinux/soda_factory_io.fc

FROM ${BASE_IMAGE}

# Keep the existing provisioning package list as the source of authority. The
# preparation command validates it and emits this argument file. Bare names:
# the transaction floats on current repositories. The resulting inventory is
# the bill-of-materials, recorded by the build after inspection. The thin
# host carries no Tailscale repository: package_inputs refuses it upstream.
COPY packages.list /run/soda-build/
RUN rpm-ostree install $(cat /run/soda-build/packages.list) && \
    mkdir -p /usr/share/soda/host-image && \
    rpm -qa --qf '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' > /run/soda-build/packages.unsorted && \
    LC_ALL=C sort /run/soda-build/packages.unsorted > /usr/share/soda/host-image/packages.txt

COPY --from=selinux-policy-build \
     /run/soda-build/selinux/soda_dashboard.pp \
     /run/soda-build/soda_dashboard.pp
COPY --from=selinux-policy-build \
     /run/soda-build/selinux/soda_factory_io.pp \
     /run/soda-build/soda_factory_io.pp
RUN semodule --noreload -i /run/soda-build/soda_dashboard.pp /run/soda-build/soda_factory_io.pp && \
    rm -f /run/soda-build/soda_dashboard.pp /run/soda-build/soda_factory_io.pp

COPY rootfs/ /
# Native rpm-ostree container finalization. Keep Fedora's update ownership;
# no alternative installer/updater or additional application image store.
# Rootful Podman allocates each project's --userns=auto range from this pool.
# The pinned base has empty mapping files; reject changed defaults for review.
# Export a plain filesystem: the inherited OSTree encoding cache is build
# transport, and the caller removes its stale chunk-layout labels before squashing.
RUN test ! -s /etc/subuid && test ! -s /etc/subgid && \
    printf 'containers:1000000:268435456\n' > /etc/subuid && \
    cp /etc/subuid /etc/subgid && \
    ostree container commit && \
    find /sysroot -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +

ARG PAYLOAD_SCOPE=host-content-only
LABEL org.opencontainers.image.title="SodaOS appliance candidate" \
      org.opencontainers.image.source="https://github.com/LevitateOS/sodaos" \
      io.soda.host-image.scope="${PAYLOAD_SCOPE}"
