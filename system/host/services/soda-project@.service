[Unit]
Description=Persistent Soda project %i
After=network-online.target soda-host.service
Wants=network-online.target soda-host.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test ! -d /var/lib/soda/dashboard/member-access/%i
ExecStart=/usr/bin/podman start --attach soda-%i
ExecStartPost=/usr/local/libexec/soda/soda-project-maintain muse --bind-only --project %i
ExecStartPost=/usr/local/libexec/soda/soda-project-maintain factory-mcp --project %i
# Queue only; enrollment never waits inside the helper's project admission gate.
ExecStartPost=-/usr/bin/systemctl --no-block start soda-tailnet@%i.service
ExecStop=/usr/bin/podman stop --time 30 soda-%i
ExecStopPost=/usr/bin/podman stop --ignore --time 30 soda-%i
Restart=on-failure
TimeoutStopSec=60
KillMode=none

[Install]
WantedBy=multi-user.target
