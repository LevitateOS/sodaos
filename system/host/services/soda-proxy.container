[Unit]
Description=Private Soda browser HTTPS endpoints
After=soda-image-import.service soda-dashboard.service forgejo.service
Requires=soda-image-import.service
ConditionPathExists=/etc/soda/activated

[Container]
Image=docker.io/library/caddy:2.11.7@sha256:5e5286cb37d44086d651a5363f05f43a692ce4d649d88fb1bd844579f45fa9e8
ContainerName=soda-proxy
Pull=never
Network=host
Volume=/etc/soda/proxy.Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/etc/soda/tls:/etc/soda/tls:ro,Z
Volume=/home/soda-applications/routes:/home/soda-applications/routes:ro,Z
Volume=/var/lib/soda/proxy:/data:Z
EnvironmentFile=/etc/soda/proxy.env

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
