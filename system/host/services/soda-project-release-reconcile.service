[Unit]
Description=Verify an explicitly requested Project release transition
ConditionPathExists=/etc/soda/activated
After=systemd-tmpfiles-setup.service soda-image-import.service soda-dashboard.service
Requires=soda-image-import.service
StartLimitIntervalSec=15min
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/soda/soda-project-maintain release-reconcile
TimeoutStartSec=450s
RestartPreventExitStatus=75
UMask=0077
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
