[Unit]
Description=Forgejo collaboration and human identity
After=network-online.target
Wants=network-online.target
Requires=soda-image-import.service soda-postgres-init.service
After=soda-image-import.service soda-postgres-init.service
Requires=soda-forgejo-migrate.service
After=soda-forgejo-migrate.service
# Database credentials exist only after operator setup; live media skips.
ConditionPathExists=/etc/soda/postgres/forgejo.passwd

[Container]
Image=codeberg.org/forgejo/forgejo:15.0.10
ContainerName=soda-forgejo
Network=soda.network
PublishPort=127.0.0.1:3000:3000
PublishPort=127.0.0.1:2222:22
Volume=/var/lib/soda/forgejo:/data:Z
Volume=/run/soda/extension:/ipc:z
Volume=/etc/soda/postgres/forgejo.passwd:/etc/forgejo/db_passwd:ro,Z
GroupAdd=2100
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=FORGEJO__server__APP_DATA_PATH=/data/gitea
Environment=FORGEJO__database__DB_TYPE=postgres
Environment=FORGEJO__database__HOST=soda-postgres:5432
Environment=FORGEJO__database__NAME=forgejo
Environment=FORGEJO__database__USER=forgejo
Environment=FORGEJO__database__PASSWD_URI=file:/etc/forgejo/db_passwd
Environment=FORGEJO__database__SSL_MODE=disable
Environment=FORGEJO__service__DISABLE_REGISTRATION=true
EnvironmentFile=/etc/soda/forgejo.env
# The required Soda native package bootstraps from this trusted catalog:
# read-only bind plus the extension identity it declares.
Volume=/usr/share/soda/extensions/catalog.json:/etc/soda/extensions/catalog.json:ro,Z
Environment=FORGEJO__extensions__CATALOG_PATH=/etc/soda/extensions/catalog.json
Volume=/var/lib/soda/project-maintenance:/var/lib/soda/project-maintenance:ro
Environment=FORGEJO__extensions__MAINTENANCE_DIRECTORY=/var/lib/soda/project-maintenance
Environment=FORGEJO__extensions__REQUIRED_IDS=soda
Environment=FORGEJO__extensions__SERVICE_BRIDGE_PEERS=2000:soda

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
