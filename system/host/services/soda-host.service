[Unit]
Description=Native Soda project provisioning
Requires=soda-host.socket
After=network-online.target

[Service]
ExecStart=/usr/local/libexec/soda/soda-host
User=root
Group=root
UMask=0077
# Allow the daemon's 200-second shutdown deadline to report unconfirmed custody.
# Retire all remaining attachment processes together when that window expires.
KillMode=control-group
TimeoutStopSec=210s
RuntimeDirectory=soda-muse-interface
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Podman and systemctl require real host namespaces. Authorization is at the
# root:soda Unix socket and the fixed operation surface, never a public listener.
