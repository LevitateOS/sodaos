[Unit]
Description=Soda dashboard
After=forgejo.service soda-host.socket
Requires=soda-host.socket
ConditionPathExists=/etc/soda/activated

[Container]
Image=localhost/soda-dashboard:dev
ContainerName=soda-dashboard
Pull=never
Network=host
User=2000:2000
DropCapability=all
ReadOnly=true
NoNewPrivileges=true
Volume=/etc/soda/dashboard.json:/etc/soda/dashboard.json:ro,Z
Volume=/etc/soda/grant-key:/etc/soda/grant-key:ro,Z
Volume=/etc/soda/postgres/soda.dsn:/etc/soda/postgres/soda.dsn:ro,Z
Volume=/run/soda/postgres:/run/soda/postgres:ro,z
# systemd owns the host and identity listener files (RemoveOnStop); a shared
# relabel would flip them to container_file_t, after which systemd can no
# longer unlink them and socket restarts fail with EADDRINUSE. Mount without
# relabeling: the dashboard connects fine under the policy var_run_t label.
Volume=/run/soda/host.sock:/run/soda/host.sock:ro
Volume=/run/soda/identity:/run/soda/identity:ro
Volume=/var/lib/soda/dashboard:/var/lib/soda/dashboard:rw,Z
Volume=/run/soda/extension:/ipc:z
Volume=/run/soda/operator:/run/soda/operator:rw,z
GroupAdd=2100
Environment=FORGEJO_EXTENSION_SERVICE_CALLBACK_SOCKET=/ipc/host.sock
# The service callback listener runs inside Forgejo as USER_UID (see
# forgejo.container); the dashboard (2000) must pin that peer identity
# or the SDK refuses the cross-user dial before any request flows.
Environment=FORGEJO_EXTENSION_SERVICE_CALLBACK_PEER_UID=1000
Exec=--extension-socket=/ipc/soda.sock --operator-socket=/run/soda/operator/operator.sock --operator-uid=0
Tmpfs=/tmp:rw,nosuid,nodev,size=64m

[Service]
Restart=on-failure
UMask=0077
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
