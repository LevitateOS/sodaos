[Unit]
Description=Soda dashboard
After=soda-image-import.service forgejo.service soda-host.socket systemd-tmpfiles-setup.service
Requires=soda-image-import.service soda-host.socket
ConditionPathExists=/etc/soda/activated

[Container]
Image=localhost/soda-dashboard:dev
ContainerName=soda-dashboard
Pull=never
Network=host
User=2000:2000
DropCapability=all
ReadOnly=true
NoNewPrivileges=true
SecurityLabelType=soda_dashboard_t
Volume=/etc/soda/dashboard.json:/etc/soda/dashboard.json:ro,Z
Volume=/etc/soda/postgres/soda.dsn:/etc/soda/postgres/soda.dsn:ro,Z
Volume=/etc/soda/factory:/etc/soda/factory:ro,Z
Volume=/run/soda/postgres:/run/soda/postgres:ro,z
# Share only the stable host IPC directory, so socket recreation remains
# visible after a daemon failure. Keep it unlabeled: systemd owns the listener
# and the appliance policy grants this dashboard only its socket access.
Volume=/run/soda/host:/run/soda/host:ro
Volume=/run/soda/identity:/run/soda/identity:ro
Volume=/var/lib/soda/dashboard:/var/lib/soda/dashboard:rw,Z
# Only the authenticated worker MCP socket directory is shared with Projects.
Volume=/var/lib/soda/dashboard/factory-ipc:/var/lib/soda/dashboard/factory-ipc:rw,z
# Read-only directory FD shares native maintenance admission; private journal
# contents remain root-only. Keep its host inode and label unchanged.
Volume=/var/lib/soda/project-maintenance:/var/lib/soda/project-maintenance:ro
Volume=/run/soda/extension:/ipc:z
Volume=/run/soda/operator:/run/soda/operator:rw,z
GroupAdd=2100
Environment=FORGEJO_EXTENSION_SERVICE_CALLBACK_SOCKET=/ipc/host.sock
# The service callback listener runs inside Forgejo as USER_UID (see
# forgejo.container); the dashboard (2000) must pin that peer identity
# or the SDK refuses the cross-user dial before any request flows.
Environment=FORGEJO_EXTENSION_SERVICE_CALLBACK_PEER_UID=1000
Exec=--extension-socket=/ipc/soda.sock --operator-socket=/run/soda/operator/operator.sock --operator-uid=0
Tmpfs=/tmp:rw,nosuid,nodev,size=64m

[Service]
Restart=on-failure
UMask=0077
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
