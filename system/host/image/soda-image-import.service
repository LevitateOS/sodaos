[Unit]
Description=Import release-owned images into ordinary Podman storage
After=systemd-tmpfiles-setup.service network-online.target
Wants=network-online.target
Before=soda-host.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/soda/soda-image-import
RemainAfterExit=yes
TimeoutStartSec=11min
UMask=0077
