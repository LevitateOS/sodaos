[Unit]
Description=Initialize Soda Docker Project configuration
After=systemd-tmpfiles-setup.service
Before=soda-image-import.service
ConditionPathExists=!/etc/soda/host.json

[Service]
Type=oneshot
PassEnvironment=SODA_PROJECT_SUBNET
UMask=0077
ExecStartPre=/usr/bin/rm -f /etc/soda/.host.json.tmp
ExecStart=/usr/bin/jq ".subnet = env.SODA_PROJECT_SUBNET" /usr/share/soda/defaults/host.example.json
ExecStartPost=/usr/bin/mv -T /etc/soda/.host.json.tmp /etc/soda/host.json
# Each command opens this output. Unlink before jq instead of using truncate:,
# which would also empty the completed file when ExecStartPost starts.
StandardOutput=file:/etc/soda/.host.json.tmp
StandardError=journal
RemainAfterExit=yes
