{
  "protocol": 1,
  "id": "soda",
  "name": "Soda",
  "version": "0.1.0",
  "executable": "run",
  "pages": [
    {
      "id": "spaces",
      "route": "workspace",
      "title": "Workspace",
      "scope": "global",
      "entry": "soda-spaces-entry.js",
      "owner": "workspace",
      "subroutes": [
        {
          "pattern": "new",
          "title": "New request"
        },
        {
          "pattern": "requests/{request}",
          "title": "Request"
        }
      ]
    },
    {
      "id": "repository-feed",
      "route": "workspace",
      "title": "SodaOS",
      "scope": "repository",
      "permission": "read",
      "entry": "soda-repository-entry.js",
      "subroutes": [
        {"pattern": "requests", "title": "Requests"},
        {"pattern": "requests/{request}", "title": "Request"},
        {"pattern": "app", "title": "App"},
        {"pattern": "knowledge", "title": "Knowledge"},
        {"pattern": "terminals", "title": "Terminals"},
        {"pattern": "settings/{section}", "title": "SodaOS settings"},
        {"pattern": "issues", "title": "Factory status"},
        {"pattern": "issues/{issue}", "title": "Factory status"}
      ]
    },
    {"id": "feed", "route": "feed", "title": "Feed", "scope": "global", "entry": "soda-feed-entry.js"},
    {"id": "applications", "route": "applications", "title": "Applications", "scope": "global", "entry": "soda-feed-entry.js"}
  ],
  "panels": [
    {
      "id": "workspace",
      "title": "Workspace",
      "entry": "soda-spaces-entry.js",
      "owner": "workspace"
    }
  ],
  "capabilities": [
    "native.actor.read",
    "native.repository.read",
    "native.repositories.owned.search",
    "native.organization.ownership",
    "native.user.public_keys.read",
    "native.contribution.authorize",
    "native.service.bridge",
    "native.background.operations",
    "native.extension.lifecycle"
  ],
  "policies": [
    "forgejo.username"
  ],
  "preferred_workspace": true
}
