{
  "protocol": 1,
  "id": "soda",
  "name": "Soda",
  "version": "0.1.0",
  "executable": "run",
  "pages": [
    {"id": "spaces", "route": "workspace", "title": "Workspace", "scope": "global", "entry": "soda-spaces-entry.js"},
    {"id": "tailnet", "route": "tailnet", "title": "Tailnet", "scope": "global", "entry": "soda-tailnet-entry.js"}
  ],
  "panels": [
    {"id": "workspace", "title": "Workspace", "entry": "soda-workspace-panel-entry.js"}
  ],
  "capabilities": [
    "native.actor.read",
    "native.repository.read",
    "native.repositories.owned.search",
    "native.organization.ownership",
    "native.user.public_keys.read",
    "native.contribution.authorize",
    "native.service.bridge",
    "native.background.operations"
  ],
  "policies": ["forgejo.username"],
  "preferred_workspace": true
}
