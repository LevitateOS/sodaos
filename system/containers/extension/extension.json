{
  "protocol": 1,
  "id": "soda",
  "name": "Soda",
  "version": "0.1.0",
  "executable": "run",
  "pages": [
    {
      "id": "repository-feed",
      "route": "feed",
      "title": "Feed",
      "scope": "repository",
      "permission": "issues",
      "entry": "soda-repository-entry.js",
      "subroutes": [
        {"pattern": "requests/{request}", "title": "Request"},
        {"pattern": "app", "title": "App"},
        {"pattern": "knowledge", "title": "Knowledge"},
        {"pattern": "terminals", "title": "Terminals"},
        {"pattern": "settings/{section}", "title": "SodaOS settings"},
        {"pattern": "work/{kind}", "title": "Work"},
        {"pattern": "work/{kind}/{item}", "title": "Work"}
      ]
    },
    {"id": "feed", "route": "feed", "title": "Feed", "scope": "global", "entry": "soda-feed-entry.js"},
    {"id": "applications", "route": "applications", "title": "Apps", "scope": "global", "entry": "soda-feed-entry.js"}
  ],
  "panels": [
    {"id": "providers", "title": "AI accounts", "entry": "soda-providers-entry.js"}
  ],
  "capabilities": [
    "native.actor.read",
    "native.repository.read",
    "native.repository.issues.read",
    "native.repositories.owned.search",
    "native.organization.ownership",
    "native.user.public_keys.read",
    "native.contribution.authorize",
    "native.service.bridge",
    "native.background.operations",
    "native.repository.runtime.control",
    "native.repository.issues.intake",
    "native.repository.comments.write",
    "native.repository.discussions.edit",
    "native.repository.discussions.lock",
    "native.repository.discussions.state",
    "native.repository.reviews.write",
    "native.repository.merges.write",
    "native.repository.issues.create",
    "native.repository.pulls.create",
    "native.extension.lifecycle"
  ],
  "policies": [
    "forgejo.username"
  ],
  "preferred_workspace": true
}
