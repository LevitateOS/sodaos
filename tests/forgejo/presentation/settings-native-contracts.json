        "button id=\"scoped-access-submit\"",
        "button type=\"submit\" aria-label=\"{{ctx.Locale.Tr \"repo.editor.add\" .FullName}}\" formnovalidate=\"true\" name=\"add_selected_repo\" value=\"{{.FullName}}\" formmethod=\"get\"",
        "button type=\"submit\" aria-label=\"{{ctx.Locale.Tr \"settings.access_token.remove\" .FullName}}\" formnovalidate=\"true\" name=\"remove_selected_repo\" value=\"{{.FullName}}\" formmethod=\"get\"",
        "button type=\"submit\" formnovalidate=\"true\" name=\"set_page\" value=\"1\" formmethod=\"get\"",
        "button type=\"submit\" formnovalidate=\"true\" name=\"set_page\" value=\"{{.Next}}\" formmethod=\"get\"",
        "button type=\"submit\" formnovalidate=\"true\" name=\"set_page\" value=\"{{.Num}}\" formmethod=\"get\"",
        "button type=\"submit\" formnovalidate=\"true\" name=\"set_page\" value=\"{{.Previous}}\" formmethod=\"get\"",
        "button type=\"submit\" formnovalidate=\"true\" name=\"set_page\" value=\"{{.TotalPages}}\" formmethod=\"get\"",
