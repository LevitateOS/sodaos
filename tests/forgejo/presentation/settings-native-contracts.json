{
  "upstream": "15.0.7",
  "presentationDeltas": [
    "one identity/navigation row; native sidebar replaced by gated menus",
    "semantic open sections and reordered account/profile groups",
    "landing autofocus removed; editor and error focus retained",
    "explicit principal/compact/control roles; no native behavioral classes removed",
    "child heading moved to shell; parent links added",
    "avatar, password and OAuth registration progressive disclosures"
  ],
