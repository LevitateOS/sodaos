        "input id=\"resource-all\" type=\"radio\" name=\"resource\" value=\"all\" {{if eq .resource \"all\"}}checked{{end}}",
        "input id=\"resource-public-only\" type=\"radio\" name=\"resource\" value=\"public-only\" {{if eq .resource \"public-only\"}}checked{{end}}",
        "input id=\"resource-repo-specific\" type=\"radio\" name=\"resource\" value=\"repo-specific\" {{if eq .resource \"repo-specific\"}}checked{{end}}",
        "input type=\"hidden\" name=\"page\" value=\"{{.Current}}\"",
        "input type=\"hidden\" name=\"selected_repo\" value=\"{{.FullName}}\"",
        "input type=\"search\" name=\"repo_search\" spellcheck=\"false\" {{if eq .Autofocus \"search\"}}autofocus{{end}} placeholder=\"{{ctx.Locale.Tr \"search.repo_kind\"}}\" value=\"{{.repo_search}}\"",
        "option value=\"\"",
        "option value=\"read:{{.}}\" {{if (SliceUtils.Contains $.scope (printf \"read:%s\" .))}} selected {{end}}",
        "option value=\"write:{{.}}\" {{if (SliceUtils.Contains $.scope (printf \"write:%s\" .))}} selected {{end}}",
        "select name=\"scope\" id=\"access-token-scope-{{.}}\""
