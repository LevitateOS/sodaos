<!doctype html>
<html lang="en" data-theme="forgejo-{{.Theme}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Soda presentation reference — {{.Theme}}</title>
<link rel="stylesheet" href="http://localhost:3300/assets/css/index.css">
<link rel="stylesheet" href="http://localhost:3300/assets/css/theme-forgejo-{{.Theme}}.css">
{{.Registry}}</head><body><main class="page-content soda-page"><div class="ui container soda-page-container">
{{template "custom/soda/page_intro" dict "Title" "Presentation reference" "Description" "Production components with minimal Forgejo 15.0.7 markup fixtures. This is not native-route evidence." "Class" "soda-page-intro--compact"}}
<section class="soda-p-section" id="button-reference"><h2 class="ui header soda-p-heading">Buttons</h2>
<div class="soda-action-row"><button class="ui primary button">Save changes</button><button class="ui button">Cancel</button><button class="ui basic button">Add file</button><button class="ui compact button">Filter</button><button class="soda-icon-action" aria-label="Edit" title="Edit">{{/* Familiar edit icon, no replacement UI behavior. */}}✎</button></div>
<div class="soda-action-row"><button class="ui button active">Selected</button><button class="ui disabled button" disabled>Unavailable</button><button class="ui primary loading button">Saving</button><button class="ui danger button">Delete</button></div>
</section>
<section class="soda-p-section"><h2 class="ui header soda-p-heading">Editor and metadata</h2>
<div class="soda-editor-layout"><form class="ui form soda-form soda-p-form" onsubmit="return false">
<div class="required field"><label for="title">Title</label><input id="title" value="A clear, consistent repository experience"><span class="help">Describe the change in one sentence.</span></div>
<div class="field"><label for="body">Description</label><div class="ui secondary menu"><button type="button" class="active item">Write</button><button type="button" class="item">Preview</button></div><textarea id="body" rows="5" placeholder="Write a description"></textarea></div>
<div class="field"><label for="attachment">Attachments</label><input id="attachment" type="file"></div>
<div class="field"><label for="date">Due date</label><input type="date" id="date"></div>
<details class="soda-p-section"><summary>Optional settings</summary><div class="field"><label for="branch">Branch</label><input id="branch" value="main"></div></details>
<div class="soda-action-row"><button type="button" class="ui button">Cancel</button><button class="ui primary button">Create issue</button></div>
</form><aside class="soda-metadata-sidebar"><section class="soda-p-section"><h3 class="ui header soda-p-heading">Labels</h3><p>No labels</p></section><section class="soda-p-section"><h3 class="ui header soda-p-heading">Milestone</h3><p>No milestone</p></section><section class="soda-p-section"><h3 class="ui header soda-p-heading">Assignees</h3><a href="#states">Assign to me</a></section></aside></div></section>
<section class="soda-p-section" id="states"><h2 class="ui header soda-p-heading">Control states</h2><form class="ui form soda-form soda-p-form" onsubmit="return false"><div class="field error"><label for="error">Validation</label><input id="error" aria-invalid="true" aria-describedby="error-help" value="Duplicate title"><span id="error-help" class="help">Choose a unique title.</span></div><div class="field"><label for="disabled">Disabled</label><input id="disabled" disabled value="Managed upstream"></div><div class="soda-action-row"><button class="ui primary button">Save changes</button><button class="ui primary loading button">Saving</button><button class="ui primary disabled button" disabled>Unavailable</button><button class="ui red button">Delete repository</button><button class="soda-icon-action" type="button" aria-label="Edit" title="Edit">✎</button></div></form></section>
<section class="soda-p-section"><h2 class="ui header soda-p-heading">Collection</h2><div class="soda-toolbar"><div class="list-header-search"><div class="ui action input"><input type="search" aria-label="Search" placeholder="Search repositories"><button class="ui button" aria-label="Search">⌕</button></div></div><button class="ui primary button">New repository</button></div><div class="soda-list"><div class="flex-list"><div class="flex-item"><div class="flex-item-main"><div class="flex-item-title"><a href="#states">activity-field-notes</a></div><div class="flex-item-body">Personal experiments and longer content.</div></div></div><div class="flex-item"><div class="flex-item-main"><div class="flex-item-title"><a href="#states">Ein sehr langer lokalisierter Repositoryname zur Überprüfung des Zeilenumbruchs</a></div><div class="flex-item-body">Updated today · 3 issues</div></div></div></div></div></section>
<section class="soda-p-section"><h2 class="ui header soda-p-heading">Joined repository controls</h2><div class="soda-repository-header"><div class="repo-buttons button-row"><div class="ui labeled button"><button type="button" class="ui compact button">Watch</button><a class="ui basic label" href="#states">24</a></div><div class="ui labeled button"><button type="button" class="ui compact button">Fork</button><div class="ui mini modal"><div class="header">Native modal placement</div></div><a class="ui basic label" href="#states">3</a></div></div></div></section>
<section class="soda-empty">{{template "custom/soda/empty_content" dict "Title" "No results" "Description" "Try a different search."}}</section>
<section class="soda-settings" id="personal-settings-gallery">
<h2>Personal settings reference</h2><p>Production navigation, styles and minimal native composition fixtures; no account submissions.</p>
<div class="soda-settings-bar"><span>Identity fixture</span>{{template "user/settings/navbar" (dict "Title" "Profile" "PageIsSettingsProfile" true)}}</div>
<div class="soda-account-details--profile"><aside class="soda-profile-portrait"><details class="soda-settings-disclosure" data-settings-editor open><summary>Avatar</summary><form class="ui form soda-p-form" onsubmit="return false"><label>Image<input type="file"></label><button class="ui primary button">Update avatar</button></form></details></aside><div class="soda-profile-editor"><form class="ui form soda-p-form" onsubmit="return false"><fieldset><legend>Public identity</legend><label>Full name<input name="full_name"></label><label>Biography<textarea></textarea></label></fieldset><button class="ui primary button">Update profile</button></form></div></div>
<section class="soda-settings-section soda-settings-explained soda-settings-preference"><h2>Theme</h2><div class="soda-settings-section-body"><form class="ui form soda-p-form" onsubmit="return false"><div class="field"><label>Theme<select class="ui selection dropdown"><option>Follow system</option></select></label></div><div class="field"><button class="ui primary button">Change theme</button></div></form></div></section>
<section class="soda-settings-section soda-settings-explained"><h2>Security</h2><div class="soda-settings-section-body"><p class="soda-factor-state">Not enrolled — fixture state</p><button class="ui primary button soda-p-control">Enroll</button><p>Native factor instructions remain beside their enrollment action.</p></div></section>
<section class="soda-settings-section"><h2 class="soda-settings-inventory-heading">Keys <button class="ui primary button soda-p-compact">Add key</button></h2><div class="flex-list"><div class="flex-item"><div class="flex-item-main"><strong>Example public key fixture</strong><p class="flex-item-body">SHA256: illustrative fingerprint · Created today</p></div><button class="ui red tiny button soda-p-compact">Delete</button></div></div></section>
</section><script src="http://localhost:3300/assets/soda/forgejo/personal-settings.js?v=3"></script>
</div></main></body></html>
