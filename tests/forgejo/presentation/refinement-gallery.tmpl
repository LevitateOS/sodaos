<!doctype html><html lang="en" data-theme="soda-{{.Theme}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Soda component refinement — {{.Theme}}</title><link rel="stylesheet" href="http://localhost:3300/assets/css/index.css"><link rel="stylesheet" href="http://localhost:3300/assets/soda/forgejo/css/theme-soda-{{.Theme}}.css">{{.Registry}}</head>
<body><main class="page-content soda-page soda-admin"><div class="ui container soda-page-container">
{{template "custom/soda/page_intro" dict "Title" "Component refinement" "Description" "Production styles and partials with representative content. Component review only; actions here do not change an account."}}
<section class="soda-p-section" id="long-controls"><h2 class="soda-p-heading">Long labels and control states</h2><div class="soda-action-row"><button class="ui primary button" id="long-label" type="button">Save repository configuration and return to your organization</button><button class="ui button active" type="button">Selected</button><button class="ui button" disabled>Unavailable</button></div><form class="ui form soda-p-form" onsubmit="return false"><div class="field"><label for="long-value">Repository identifier</label><input id="long-value" value="a-long-repository-name-with-several-words"></div><div class="field error"><label for="invalid-value">Validation</label><input id="invalid-value" aria-invalid="true" aria-describedby="invalid-help" value="Already in use"><span class="help" id="invalid-help">Choose a unique name for this repository.</span></div><hr><div class="soda-form-actions"><button class="ui primary button">Save configuration</button></div></form></section>
<section class="soda-p-section soda-admin-layout" id="admin-reference"><h2 class="soda-p-heading">Administration and technical content</h2><aside class="flex-container-nav"><nav class="ui vertical menu" aria-label="Administrative sections"><div class="header item">Administration</div><a class="active item" href="#admin-reference" aria-current="page">Overview</a><a class="item" href="#admin-reference">Authentication sources and external integrations</a><details class="item"><summary>Monitoring and diagnostics</summary><div class="menu"><a class="item" href="#admin-reference">Background jobs</a></div></details></nav></aside><div class="flex-container-main"><section class="soda-admin-details soda-admin-details--config"><dl class="admin-dl-horizontal"><dt>Configuration file</dt><dd>/var/lib/soda/forgejo/gitea/conf/an-extremely-long-configuration-file-name.ini</dd><dt>Service state</dt><dd>Available</dd></dl></section><section class="soda-admin-monitoring"><div class="soda-monitoring-table"><table class="ui single line table"><thead><tr><th>Background task</th><th>Last execution</th><th>Queue depth</th></tr></thead><tbody><tr><td>Repository synchronization and maintenance</td><td>2026-09-12 10:42:00 UTC</td><td>0</td></tr></tbody></table></div></section></div></section>
<section class="soda-p-section soda-shared-runner"><h2 class="soda-p-heading">Runner details</h2><dl><div class="item"><dt>Name</dt><dd>a-runner-name-that-remains-readable-on-a-small-screen-without-moving-the-page</dd></div><div class="item"><dt>Labels</dt><dd>linux, x86_64, development</dd></div></dl></section>
<section class="soda-p-section"><h2 class="soda-p-heading">Empty and disclosure states</h2><div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-key" "Title" "No deploy keys" "Description" "Add a key when another system needs access to this repository."}}</div><div class="soda-quota-overview"><details class="stats"><summary>Storage usage and limits</summary><ul><li>Repository data: 12 MiB</li><li>Package data: 24 MiB</li></ul></details></div></section>
<section class="soda-p-section"><h2 class="soda-p-heading">Creation form composition</h2><div class="soda-form-layout" id="creation-reference">{{template "custom/soda/page_intro" dict "TitleID" "creation-title" "Title" "Create a repository" "Description" "A clear home for the next project." "Class" "soda-form-story"}}<div class="soda-form-content"><form class="ui form soda-form" onsubmit="return false"><div class="required inline field"><label for="creation-name">Repository name</label><input id="creation-name" required><span class="help">Choose a name your team can recognize.</span></div><div class="inline field"><label for="creation-description">Description</label><textarea id="creation-description" rows="3"></textarea></div><fieldset class="soda-form-section"><legend>Visibility</legend><label><input type="radio" name="visibility" checked> Private</label><label><input type="radio" name="visibility"> Public</label></fieldset><div class="soda-form-actions"><button class="ui button" type="button">Cancel</button><button class="ui primary button">Create repository</button></div></form></div></div></section>
</div></main></body></html>
