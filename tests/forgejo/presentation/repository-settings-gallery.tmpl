<!doctype html>
<html lang="en" data-theme="forgejo-{{.Theme}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Repository settings reference — {{.Theme}}</title>
<link rel="stylesheet" href="http://localhost:3300/assets/css/index.css"><link rel="stylesheet" href="http://localhost:3300/assets/css/theme-forgejo-{{.Theme}}.css">{{.Registry}}</head>
<body><main class="page-content soda-page soda-settings-shell soda-repository-settings"><div class="soda-repository-header" aria-hidden="true"></div><div class="ui container soda-page-container">
<p>Production navigation and runner editor, with minimal native collection/form fixtures. This is component evidence, not a repository-admin session.</p>
<div class="soda-settings-bar soda-repo-settings-bar"><h1 id="soda-settings-title" class="soda-p-title">Repository settings</h1>{{template "repo/settings/navbar" .RepositoryFixture}}</div>
<div class="soda-settings-layout"><div class="flex-container-main"><div class="repo-setting-content soda-repo-settings-detail">
<section class="soda-settings-section"><h2 class="soda-p-heading">Basic settings</h2><div class="soda-settings-section-body"><form class="ui form soda-p-form" onsubmit="return false"><div class="field"><label for="repo-name">Repository name</label><input id="repo-name" value="Fixture repository"></div><div class="field"><label for="repo-description">Description</label><textarea id="repo-description">A native repository form composition.</textarea></div><div class="inline field"><label for="repo-avatar">Choose new avatar</label><input id="repo-avatar" name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp"><br><span class="help">Native upload limits stay with the file picker.</span></div><div class="ui info message soda-notice">Context for this configuration stays beside its controls.</div><button class="ui primary button">Save changes</button></form></div></section>
<section class="soda-settings-section"><h2 class="soda-settings-inventory-heading soda-p-heading">Deploy keys <div class="ui right"><button class="ui primary button">Add key</button></div></h2><div class="soda-settings-section-body"><div class="soda-empty soda-empty--compact">{{template "custom/soda/empty_content" dict "Icon" "octicon-key" "Title" "There are no deploy keys yet."}}</div></div></section>
<section class="soda-settings-section"><h2 class="soda-p-heading">Runner editor</h2><div class="soda-settings-section-body">{{template "shared/actions/runner_create" (dict "SettingsPresentation" true "ctxData" .RunnerFixture)}}</div></section>
<section class="soda-settings-section"><h2 class="soda-p-heading">Technical inventory</h2><div class="soda-settings-section-body"><div class="soda-settings-table-scroll"><table class="ui single line table"><thead><tr><th>Object</th><th>Size</th><th>State</th></tr></thead><tbody><tr><td><code>sha256:long-native-data-value-to-exercise-table-containment</code></td><td>24 KiB</td><td>Available</td></tr></tbody></table></div></div></section>
<section class="soda-settings-section"><h2 class="soda-p-heading">Danger zone</h2><div class="soda-settings-section-body"><div class="ui negative message soda-notice">Destructive native actions retain their explicit consequences and confirmation.</div><button class="ui red button" type="button">Delete repository</button></div></section>
</div></div></div></div></main><script defer src="http://localhost:3300/assets/soda/forgejo/personal-settings.js?v=7"></script></body></html>
