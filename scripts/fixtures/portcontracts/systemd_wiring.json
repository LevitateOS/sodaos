{
  "installed_paths": [
    "project-os/rootfs/usr/libexec/soda/project-init"
  ],
  "units": [
    {
      "file": "appliance/services/soda-host.socket",
      "lines": [
        "ListenStream=/run/soda/host.sock"
      ]
    },
    {
      "file": "appliance/services/soda-host.service",
      "lines": [
        "ExecStart=/usr/local/libexec/soda/soda-host",
        "Requires=soda-host.socket"
      ]
    },
    {
      "file": "appliance/services/soda-identity.socket",
      "lines": [
        "ListenStream=/run/soda/identity/admin.sock",
        "FileDescriptorName=admin"
      ]
    },
    {
      "file": "appliance/services/soda-identity-runtime.socket",
      "lines": [
        "ListenStream=/run/soda/identity/runtime.sock",
        "FileDescriptorName=runtime"
      ]
    },
    {
      "file": "appliance/services/soda-identity.service",
      "lines": [
        "ExecStart=/usr/local/libexec/soda/soda-identity",
        "Requires=soda-host.socket soda-identity.socket soda-identity-runtime.socket",
        "Sockets=soda-identity.socket soda-identity-runtime.socket"
      ]
    },
    {
      "file": "appliance/services/soda-tailnet@.service",
      "lines": [
        "ExecStart=/usr/local/libexec/soda/soda-host --tailnet-action=run --project=%i",
        "ExecStop=/usr/local/libexec/soda/soda-host --tailnet-action=stop --project=%i"
      ]
    },
    {
      "file": "appliance/services/soda-project@.service",
      "lines": [
        "ExecStartPost=/usr/local/libexec/soda/soda-muse-maintain --bind-only --project %i"
      ]
    },
    {
      "file": "appliance/services/soda-pg-provision.service",
      "lines": [
        "ExecStart=/usr/bin/soda-setup --provision-db-only"
      ]
    }
  ]
}
