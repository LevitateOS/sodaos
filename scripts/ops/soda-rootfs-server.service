# soda-rootfs-server.service — STAGED persistent installer-rootfs server (D3).
#
# Status: staged only. This change never installs, restarts, or edits host
# units. Installing this file is an explicit owner decision (host mutation):
#   go build -o "$HOME/soda-rootfs-server" ./cmd/soda-rootfs-server
#   sudo install -m 0755 "$HOME/soda-rootfs-server" \
#     /usr/local/lib/soda/soda-rootfs-server
#   rm "$HOME/soda-rootfs-server"
#   sudo install -m 0644 scripts/ops/soda-rootfs-server.service \
#     /etc/systemd/system/soda-rootfs-server.service
#   sudo cp /home/libvirt/images/*-rootfs.img /home/soda-rootfs/
#   sudo chown root:root /home/soda-rootfs/*-rootfs.img
#   sudo chmod 0644 /home/soda-rootfs/*-rootfs.img
#   sudo systemctl daemon-reload
#   sudo systemctl restart soda-rootfs-server.service
#   curl -s http://192.168.122.1:8080/ | head -1    # expect 404, no listing
#   curl -s -o /dev/null -w '%{http_code}\n' \
#     http://192.168.122.1:8080/soda-iso28.qcow2    # expect 404
#
# Convergence: setup (soda-candidate-setup), build filing
# (--rootfs-dir), and this unit share one rootfs-only directory,
# /home/soda-rootfs on the roomy disk. Copy only *-rootfs.img into it:
# QCOW2 guest disks and installer ISOs stay in /home/libvirt/images and
# are unservable from here by path construction. Retained VMs remain
# intact; never move their disks.
#
# The unit runs the single Go server source cmd/soda-rootfs-server
# (installed as /usr/local/lib/soda/soda-rootfs-server) with no second
# copy: no commented duplicate, no encoded blob. It serves exact
# ^[0-9a-f]{64}-rootfs\.img$ names on the same guest-reachable address
# and denies listings, QCOW2, ISO, traversal, subpaths, symlinks, and
# non-GET/HEAD methods by construction. Behavior checks live in
# cmd/soda-rootfs-server/main_test.go.
#
# Design: DynamicUser (no new account), read-only /home, no new
# privileges, memory and CPU bounds, loopback-independent fixed bridge
# bind: guests fetch 192.168.122.1:8080.
#
[Unit]
Description=SodaOS install rootfs exact-file HTTP server for libvirt guests
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/soda/soda-rootfs-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=10s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=192.168.122.0/24
MemoryMax=512M
CPUQuota=100%
UMask=0077

[Install]
WantedBy=multi-user.target
