[Unit]
Description=SodaOS install rootfs exact-file HTTP server for libvirt guests
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -c "import base64;exec(compile(base64.b64decode(''),'soda-rootfs-server','exec'))"
Restart=on-failure
RestartSec=5
TimeoutStopSec=10s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=192.168.122.0/24
MemoryMax=512M
CPUQuota=100%
UMask=0077

[Install]
WantedBy=multi-user.target
