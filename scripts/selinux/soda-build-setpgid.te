module soda-build-setpgid 1.0;

require {
	type init_t;
	class process setpgid;
}

# The isolated build worker owns its child process groups (acceptance
# process tracking) but runs as an init_t systemd transient unit. Without
# this, every worker child fails with a misleading "permission denied" on
# its own executable. Self-process-group ownership only; nothing else.
allow init_t self:process setpgid;
