module soda-build-worker 1.0;

require {
	type init_t;
	type init_tmp_t;
	type init_var_lib_t;
	type initrc_tmp_t;
	type sshd_t;
	type ssh_keygen_tmp_t;
	type certmaster_port_t;
	type cluster_port_t;
	type cyphesis_port_t;
	type gear_port_t;
	type gluster_port_t;
	type hadoop_datanode_port_t;
	type hplip_port_t;
	type isns_port_t;
	type keystone_port_t;
	type matahari_port_t;
	type postgrey_port_t;
	type virt_migration_port_t;
	type tmp_t;
	type ptmx_t;
	type devpts_t;
	type ephemeral_port_t;
	type unreserved_port_t;
	type unconfined_t;
	type setfiles_t;
	attribute file_type;
	class process setpgid;
	class file { create open read write getattr setattr lock append unlink rename map relabelfrom relabelto execute entrypoint execmod execute_no_trans };
	class dir { create open read write getattr setattr search add_name remove_name rmdir relabelfrom relabelto };
	class lnk_file { create read getattr setattr unlink rename };
	class tcp_socket { name_connect };
	class chr_file { read write open ioctl };
}

# The isolated build worker runs Go as an init_t systemd transient unit:
# lib_t toolchain executables transition out of the service domain, while
# bun, python and tar stay put. Go mmaps build-cache export data and
# telemetry counters, and targeted policy withholds map on the default
# var_lib_t worker home, so every package load fails with a synthesized
# "could not import ... (permission denied)" and no failing open syscall.
# A dedicated cache type grants init_t exactly its Go state dirs. Podman
# storage, the runtime dir and the frontend caches keep their types so the
# container stack and offline module warming are undisturbed.
type soda_build_cache_t;
# semanage only records file contexts for file_type members.
typeattribute soda_build_cache_t file_type;

allow init_t self:process setpgid;
# go test builds and runs test binaries in the unit's PrivateTmp, which
# carries init_tmp_t. The tmpfs is per-unit private, so executing it here
# stays inside the worker's own sandbox.
allow init_t init_tmp_t:file { execute execute_no_trans read map open getattr };
# Suite tests create and verify symlinks in PrivateTmp, and httptest-based
# suites connect to ephemeral (and unreserved) localhost ports.
allow init_t init_tmp_t:lnk_file { create read getattr setattr unlink rename };
# Suite temp dirs land on tmp_t here, and the enrollment PTY test drives a
# pty master. Teardown-time unlink noise from systemd itself is excluded.
allow init_t tmp_t:lnk_file { create read getattr unlink rename };
allow init_t ptmx_t:chr_file { read write open ioctl };
allow init_t devpts_t:chr_file { open read write ioctl };
# httptest fixtures bind :0 and the kernel deals ports across the whole
# ephemeral range, including holes labeled for other services (derived from
# the portcon entries intersecting ip_local_port_range; re-derive if the
# range moves). Nothing else listens on these ports inside the worker.
allow init_t { ephemeral_port_t unreserved_port_t certmaster_port_t cluster_port_t cyphesis_port_t gear_port_t gluster_port_t hadoop_datanode_port_t hplip_port_t isns_port_t keystone_port_t matahari_port_t postgrey_port_t virt_migration_port_t }:tcp_socket name_connect;
# Shell children of the test binaries run as initrc_t, so files they write
# (the subreaper pidfile) and scripts the tests stage under var_lib_t need
# init_t access back.
allow init_t initrc_tmp_t:file { open read unlink getattr };
allow init_t init_var_lib_t:file { execute execute_no_trans read map open getattr };
# The enrollment parse test runs native sshd -T against a synthetic config
# and key in suite temp dirs; sshd only reads them, and the suite unlinks
# the synthetic keys at cleanup. Read-only for sshd; unlink-only for init_t.
allow sshd_t init_tmp_t:file { open read getattr };
allow sshd_t ssh_keygen_tmp_t:file { open read getattr };
allow init_t ssh_keygen_tmp_t:file { unlink };
allow init_t soda_build_cache_t:file { create open read write getattr setattr lock append unlink rename map };
allow init_t soda_build_cache_t:dir { create open read write getattr setattr search add_name remove_name rmdir };
# Provisioning (setup, restorecon) runs outside the worker domain and must
# be able to label the cache dirs; without relabelto even root cannot.
allow unconfined_t soda_build_cache_t:file { getattr relabelfrom relabelto };
allow unconfined_t soda_build_cache_t:dir { getattr search read open relabelfrom relabelto };
allow setfiles_t soda_build_cache_t:file { getattr relabelfrom relabelto };
allow setfiles_t soda_build_cache_t:dir { getattr search read open relabelfrom relabelto };
