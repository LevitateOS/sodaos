[Unit]
Description=Project-local shared Podman service
Requires=soda-project-init.service soda-podman.socket
After=soda-project-init.service soda-podman.socket

[Service]
User=root
# Keep the engine's native root identity; only the socket is group-accessible.
Group=root
Type=exec
KillMode=process
UMask=0007
# Even an empty CONTAINER_HOST selects remote mode in Podman 5.8.2.
# The service must run the local engine, not connect back to itself.
UnsetEnvironment=CONTAINER_HOST
# Use the native systemd activation FD; the socket unit owns access permissions.
ExecStart=/usr/bin/podman system service --time=0
Restart=on-failure

[Install]
WantedBy=multi-user.target
