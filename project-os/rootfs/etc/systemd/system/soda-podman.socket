[Unit]
Description=Project-local Podman API socket for project administrators
# Do not order this socket after init: sockets.target precedes basic.target,
# which precedes init. The activated service requires init before accepting work.

[Socket]
ListenStream=/run/soda-podman/podman.sock
SocketUser=root
SocketGroup=wheel
SocketMode=0660
DirectoryMode=0750

[Install]
WantedBy=sockets.target
