#!/usr/bin/python3
"""Bounded, stateless native account setup; called only by the host project helper."""
import json, os, pwd, re, subprocess, sys
from pathlib import Path

if os.geteuid() != 0:
    sys.exit('project-local root required')
data = json.loads(sys.stdin.buffer.read(65537))
if set(data) != {'login', 'identity', 'admin', 'keys'}:
    sys.exit('unsupported account request')
login, identity = data['login'], data['identity']
if not isinstance(login, str) or not re.fullmatch(r'[a-z][a-z0-9_-]{0,30}', login):
    sys.exit('unsupported Linux username')
if type(identity) is not int or identity <= 0 or type(data['admin']) is not bool:
    sys.exit('invalid identity or privilege')
keys = data['keys']
if not isinstance(keys, list) or not keys or any(not isinstance(k, str) or '\n' in k.strip() or not re.fullmatch(r'(ssh-[\w-]+|ecdsa-[\w-]+|sk-[\w@.-]+) [A-Za-z0-9+/=]+\s*', k) for k in keys):
    sys.exit('invalid canonical public keys')
marker = Path('/var/lib/soda/accounts') / login
try:
    account = pwd.getpwnam(login)
except KeyError:
    subprocess.run(['useradd', '--create-home', '--shell', '/bin/bash', '--groups', 'soda-project', login], check=True)
    account = pwd.getpwnam(login)
    marker.write_text(str(identity))
    marker.chmod(0o600)
else:
    if not marker.is_file() or marker.read_text() != str(identity):
        sys.exit('existing native account is not associated with this identity')
# Keys are root-owned, independent of user-controlled home symlinks.
keyfile = Path('/etc/ssh/authorized_keys') / login
with keyfile.open('w') as f:
    f.write('\n'.join(k.strip() for k in keys) + '\n')
keyfile.chmod(0o644)
shared = Path(account.pw_dir) / 'shared'
if not shared.exists() and not shared.is_symlink():
    shared.symlink_to('/srv/project/shared', target_is_directory=True)
if data['admin']:
    subprocess.run(['usermod', '--append', '--groups', 'wheel', login], check=True)
print(json.dumps({'login': login, 'identity': identity}))
