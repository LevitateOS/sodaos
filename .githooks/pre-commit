#!/bin/bash
# Pre-commit gate: fast checks on staged changes only. Legacy violations in
# untouched files never block a commit; new violations in staged files do.
# Bypass with `git commit --no-verify` when the gate itself is at fault.
set -euo pipefail
cd "$(dirname "$0")/.."
export GOWORK=off GOFLAGS=-mod=readonly CGO_ENABLED=0 GOTOOLCHAIN=local
fail=0

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
[ -z "$staged" ] && exit 0

# 1. Whitespace errors (trailing whitespace, etc.) in staged lines.
if ! git diff --cached --check --; then
  fail=1
fi

# 2. Credential-shaped strings in staged additions. tskey-* is the Tailscale # slop-audit-allow: documents the scanned Tailscale credential shape
# shape production legitimately validates (credentialPattern, authKeyPattern),
# so fixtures must wear it to exercise the real path; those sites carry an
# explicit `slop-audit-allow` marker with the reason. Test trees are out of
# scope for the staged hook (whole-tree L1.14 scans still cover them).
# Private-key blocks and AWS key IDs are never allowlisted: no legitimate
# site needs them.
cred_hits=$(git diff --cached -U0 --diff-filter=ACM -- . | awk '
/^\+\+\+ / { file = substr($0, 7); sub(/^b\//, "", file); next }
/^@@ / { split($0, h, /\+/); split(h[2], n, /[, ]/); line = n[1] - 1; next }
/^\+/ && !/^\+\+\+/ {
  line++
  body = substr($0, 2)
  skip = (file ~ /_test\.go$/ || file ~ /\.test\.ts$/ || file ~ /^tests\//)
  if (!skip && body ~ /tskey-/ && body !~ /slop-audit-allow/) print file":"line": tskey-shaped value without allow marker"
  if (body ~ /BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}/) print file":"line": private-key block or AWS key ID"
  next }
' || true)
if [ -n "$cred_hits" ]; then
  printf 'pre-commit: credential-shaped string in staged additions:\n%s\n' "$cred_hits" | head -n 10
  fail=1
fi

# 3. Cyclomatic complexity below 10 on staged shipping Go (not scripts/tests).
gofiles=$(printf '%s\n' "$staged" | grep '\.go$' || true)
prodgofiles=$(printf '%s\n' "$staged" | grep '\.go$' | grep -E '^(internal|cmd|tools|appliance|project-os)/' | grep -v '_test\.go$' || true)
if [ -n "$prodgofiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-complexity.sh $prodgofiles; then
    printf 'pre-commit: complexity gate failed on staged shipping Go files.\n'
    fail=1
  fi
fi

# 4. gofumpt on staged Go files (strict gofmt; whole-tree backlog is not
# blocking). Zero tolerance on staged files.
if [ -n "$gofiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-gofumpt.sh $gofiles; then
    printf 'pre-commit: gofumpt gate failed on staged files (run gofumpt -w).\n'
    fail=1
  fi
fi

# 5–7. Package analyzers on staged Go (linux build).
if [ -n "$gofiles" ]; then
  gopkgs=$(printf '%s\n' "$gofiles" | xargs -n1 dirname | sort -u | sed 's|^|./|;s|$|/|' || true)
  # shellcheck disable=SC2086
  if ! GOOS=linux bash scripts/check-staticcheck.sh $gopkgs; then
    printf 'pre-commit: staticcheck failed on staged packages.\n'
    fail=1
  fi
  # shellcheck disable=SC2086
  if ! GOOS=linux bash scripts/check-errcheck.sh $gopkgs; then
    printf 'pre-commit: errcheck failed on staged packages.\n'
    fail=1
  fi
  # shellcheck disable=SC2086
  if ! GOOS=linux go vet -mod=readonly $gopkgs; then
    printf 'pre-commit: go vet failed on staged packages.\n'
    fail=1
  fi
fi

# 8. Oxfmt on staged TypeScript (zero tolerance; whole-tree backlog is not
# blocking). Darwin-safe: no GOOS, uses the Bun-locked oxfmt binary.
tsfiles=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx)$' || true)
if [ -n "$tsfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-oxfmt.sh $tsfiles; then
    printf 'pre-commit: oxfmt gate failed on staged TypeScript (run oxfmt --write).\n'
    fail=1
  fi
fi

# 9. Cyclomatic complexity below 10 on staged browser-payload TypeScript.
prodtsfiles=$(printf '%s\n' "$tsfiles" | grep -E '^(frontend/|assets/branding/)' | grep -v -E '(/fixtures/|/testdata/|\.test\.ts$)' || true)
if [ -n "$prodtsfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-ts-complexity.sh $prodtsfiles; then
    printf 'pre-commit: TypeScript complexity gate failed on staged browser-payload files.\n'
    fail=1
  fi
fi

# 10. Oxlint correctness on staged TypeScript (complexity is the previous step).
if [ -n "$tsfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-oxlint.sh $tsfiles; then
    printf 'pre-commit: oxlint failed on staged TypeScript.\n'
    fail=1
  fi
fi

# 11. Ruff format on staged Python (zero tolerance; whole-tree backlog is not
# blocking). Darwin-safe: no GOOS.
pyfiles=$(printf '%s\n' "$staged" | grep '\.py$' || true)
if [ -n "$pyfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-ruff-format.sh $pyfiles; then
    printf 'pre-commit: ruff format gate failed on staged Python (run ruff format).\n'
    fail=1
  fi
fi

# 12. Cyclomatic complexity below 10 on staged shipping Python.
prodpyfiles=$(printf '%s\n' "$pyfiles" | grep -E '^(internal|cmd|appliance|project-os)/' | grep -v '_test\.py$' || true)
if [ -n "$prodpyfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-py-complexity.sh $prodpyfiles; then
    printf 'pre-commit: Python complexity gate failed on staged shipping files.\n'
    fail=1
  fi
fi

# 13. Ruff correctness on staged Python (complexity is the previous step).
if [ -n "$pyfiles" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/check-ruff.sh $pyfiles; then
    printf 'pre-commit: ruff failed on staged Python.\n'
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  printf 'pre-commit gate failed. Fix the findings or bypass with --no-verify.\n'
  exit 1
fi
printf 'pre-commit gate passed.\n'
