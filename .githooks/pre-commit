#!/bin/bash
# Pre-commit gate: fast checks on staged changes only. Legacy violations in
# untouched files never block a commit; new violations in staged files do.
# Bypass with `git commit --no-verify` when the gate itself is at fault.
set -euo pipefail
cd "$(dirname "$0")/.."
export GOWORK=off GOFLAGS=-mod=readonly CGO_ENABLED=0 GOTOOLCHAIN=local
fail=0

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
[ -z "$staged" ] && exit 0

# 1. Whitespace errors (trailing whitespace, etc.) in staged lines.
if ! git diff --cached --check --; then
  fail=1
fi

# 2. Credential-shaped strings in staged additions. tskey-* is the Tailscale # slop-audit-allow: documents the scanned Tailscale credential shape
# shape production legitimately validates (credentialPattern, authKeyPattern),
# so fixtures must wear it to exercise the real path; those sites carry an
# explicit `slop-audit-allow` marker with the reason. Test trees are out of
# scope for the staged hook (whole-tree L1.14 scans still cover them).
# Private-key blocks and AWS key IDs are never allowlisted: no legitimate
# site needs them.
cred_hits=$(git diff --cached -U0 --diff-filter=ACM -- . | awk '
/^\+\+\+ / { file = substr($0, 7); sub(/^b\//, "", file); next }
/^@@ / { split($0, h, /\+/); split(h[2], n, /[, ]/); line = n[1] - 1; next }
/^\+/ && !/^\+\+\+/ {
  line++
  body = substr($0, 2)
  skip = (file ~ /_test\.go$/ || file ~ /\.test\.ts$/ || file ~ /^tests\//)
  if (!skip && body ~ /tskey-/ && body !~ /slop-audit-allow/) print file":"line": tskey-shaped value without allow marker"
  if (body ~ /BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}/) print file":"line": private-key block or AWS key ID"
  next }
' || true)
if [ -n "$cred_hits" ]; then
  printf 'pre-commit: credential-shaped string in staged additions:\n%s\n' "$cred_hits" | head -n 10
  fail=1
fi

# Keep language ownership checks scoped to the staged paths.
if printf '%s\n' "$staged" | grep -E '\.py$|\.pyi$' >/dev/null; then
  printf 'pre-commit: authored Python is outside the project language policy.\n'
  fail=1
fi

# Formatting, analyzers and behavioral tests run when relevant to the change.
# Committing does not repeat those checks or require complexity paperwork.
if [ "$fail" -ne 0 ]; then
  exit 1
fi
