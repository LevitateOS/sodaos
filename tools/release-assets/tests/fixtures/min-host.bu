{
  "variant": "fixture",
  "version": "0.0",
  "storage": {
    "files": [
      {
        "path": "/etc/hostname",
        "mode": 420,
        "contents": {
          "inline": "soda-native-fixture\n"
        }
      }
    ]
  },
  "empty": {},
  "nothing": null,
  "flag": true,
  "passwd": {
    "users": [
      {
        "name": "root",
        "ssh_authorized_keys": [
          "ssh-ed25519 AAAA synthetic-fixture-key"
        ],
        "password_hash": "$6$synthetic$fixture-hash"
      }
    ]
  }
}
